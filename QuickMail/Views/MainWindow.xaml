<Window x:Class="QuickMail.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuickMail.Views"
        xmlns:models="clr-namespace:QuickMail.Models"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="800" Width="1280"
        MinHeight="520" MinWidth="980"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}"
        StateChanged="MbxWindow_StateChanged">

    <!-- MailBox MatriX: borderless frame. The app draws its own caption buttons over the scenic main
         area (MainWindow.MailBoXX.cs); resizing and Aero Snap stay with Windows. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:BoolToFontWeightConverter x:Key="BoolToWeightConverter"/>
        <BooleanToVisibilityConverter    x:Key="BoolToVisibilityConverter"/>
        <local:BoolToGridLengthConverter        x:Key="BoolToGridLengthConverter"/>
        <local:StringToVisibilityConverter      x:Key="StringToVisibilityConverter"/>
        <local:StringToBrushConverter           x:Key="StringToBrushConverter"/>

        <!-- ── MailBox MatriX shell resources ── Every color and size is a Theme.* token
             (ThemeRegressionGuardTests); these styles are self-contained so they also work under
             High Contrast, where QuickMail withdraws ThemedControls. -->
        <local:InitialConverter x:Key="InitialConverter"/>
        <local:ContextImageBrushConverter x:Key="ContextImageBrushConverter"/>
        <local:AccountProviderConverter x:Key="AccountProviderConverter"/>
        <local:FolderGlyphConverter x:Key="FolderGlyphConverter"/>
        <local:MainFolderLabelConverter x:Key="MainFolderLabelConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <local:AvatarColorIndexConverter x:Key="AvatarColorIndexConverter"/>
        <!-- Replaced at runtime when the user picks their own picture (Settings). -->
        <BitmapImage x:Key="Mbx.ScenicImageSource"
                     UriSource="pack://application:,,,/MailBoxMatriX;component/Assets/Scenic/serengeti-kopjes.jpg"/>

        <Style x:Key="Mbx.CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="{DynamicResource Theme.FontSizeSmall}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.ReadingSurface}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Glyphs sit straight on the picture (no patch behind them); a soft halo in the
                         surface colour keeps them readable on any part of the photo. -->
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="back" Background="{TemplateBinding Background}" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.9"
                                                      Color="{DynamicResource Theme.SurfaceBackground.Color}"/>
                                </ContentPresenter.Effect>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="back" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Mbx.CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource Mbx.CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme.Error}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextOnAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Mbx.SidebarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Theme.SidebarText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.SidebarHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.SidebarSelection}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Mbx.IconButton" TargetType="Button">
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="{DynamicResource Theme.FontSizeLarge}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.AccentSubtle}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.SelectionInactive}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Mbx.TextDropDownButton" TargetType="Button" BasedOn="{StaticResource Mbx.IconButton}">
            <Setter Property="FontSize" Value="{DynamicResource Theme.FontSizeBase}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center"/>
                                <local:AriaHiddenTextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="{DynamicResource Theme.FontSizeSmall}"
                                                           Margin="8,2,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.AccentSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 10 Mail-style text tab: accent text and underline when selected. -->
        <Style x:Key="Mbx.PlaceholderTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="FontSize" Value="{DynamicResource Theme.FontSizeLarge}"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Background="Transparent">
                            <ContentPresenter Margin="0,4,0,6"/>
                            <Rectangle x:Name="underline" Height="3" Fill="{DynamicResource Theme.Accent}"
                                       Visibility="Hidden"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="underline" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Square search field. -->
        <Style x:Key="Mbx.SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.InputBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.InputBorder}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,7,34,7"/>
            <Setter Property="FontSize" Value="{DynamicResource Theme.FontSizeLarge}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          Focusable="False" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- View Mode menu entries (#663).
             The menu is bound to MainViewModel.ViewModeOptions, which holds only the four
             modes that apply right now — the mail groupings, or the calendar slices. It used
             to declare all eight and collapse the inapplicable four, but a collapsed MenuItem
             is still a child of its parent's automation peer, so a screen reader counted eight
             items in a menu showing four.

             The ancestor for the command is MenuBase, which covers both hosts: the View menu
             (inside a Menu) and the toolbar button's ContextMenu. Both carry the MainViewModel
             as their DataContext — the ContextMenu by way of its PlacementTarget binding. -->
        <Style x:Key="ViewModeMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Header}"/>
            <!-- The header carries a mnemonic underscore; the accessible name must not. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <!-- IsCheckable="True" is what makes the automation peer expose the Toggle
                 pattern, so the active mode is announced as checked. -->
            <Setter Property="IsCheckable" Value="True"/>
            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}"/>
            <Setter Property="Command"
                    Value="{Binding DataContext.SelectViewModeCommand,
                                    RelativeSource={RelativeSource AncestorType={x:Type prim:MenuBase}}}"/>
            <Setter Property="CommandParameter" Value="{Binding}"/>
        </Style>

        <!-- ── Shared context menus ── -->

        <!-- Sender-group context menu (root level of SenderGroupTree) -->
        <ContextMenu x:Key="SenderGroupContextMenu"
                     AutomationProperties.Name="Sender group actions"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="_Reply"
                      AutomationProperties.Name="Reply"
                      Command="{Binding ReplySenderGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Reply _All"
                      AutomationProperties.Name="Reply All"
                      Command="{Binding ReplyAllSenderGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="_Forward"
                      AutomationProperties.Name="Forward"
                      Command="{Binding ForwardSenderGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="_Move to Folder…"
                      AutomationProperties.Name="Move Sender Group to Folder"
                      Click="SenderGroupContextMenu_MoveToFolder_Click"/>
            <MenuItem Header="_Copy to Folder…"
                      AutomationProperties.Name="Copy Sender Group to Folder"
                      Click="SenderGroupContextMenu_CopyToFolder_Click"/>
            <MenuItem Header="Sa_ve Messages As…"
                      AutomationProperties.Name="Save Messages from Sender As"
                      Click="MenuSaveAs_Click"/>
            <Separator/>
            <MenuItem Header="_Delete All from Sender"
                      AutomationProperties.Name="Delete All from Sender"
                      Command="{Binding DeleteSenderGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Arc_hive All from Sender"
                      AutomationProperties.Name="Archive All from Sender"
                      Command="{Binding ArchiveSenderGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Flag_s"
                      Tag="FlagsSubmenu"
                      AutomationProperties.Name="Flags"/>
            <Separator/>
            <MenuItem Header="E_xpand Group"
                      AutomationProperties.Name="Expand Group"
                      Command="{Binding ExpandSenderGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Colla_pse Group"
                      AutomationProperties.Name="Collapse Group"
                      Command="{Binding CollapseSenderGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="_Expand All Groups"
                      AutomationProperties.Name="Expand All Groups"
                      Command="{Binding ExpandAllSenderGroupsCommand}"/>
            <MenuItem Header="Collapse A_ll Groups"
                      AutomationProperties.Name="Collapse All Groups"
                      Command="{Binding CollapseAllSenderGroupsCommand}"/>
        </ContextMenu>

        <ContextMenu x:Key="ToGroupContextMenu"
                     AutomationProperties.Name="Recipient group actions"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="_Reply"
                      AutomationProperties.Name="Reply"
                      Command="{Binding ReplyToGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Reply _All"
                      AutomationProperties.Name="Reply All"
                      Command="{Binding ReplyAllToGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="_Forward"
                      AutomationProperties.Name="Forward"
                      Command="{Binding ForwardToGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="_Move to Folder…"
                      AutomationProperties.Name="Move Recipient Group to Folder"
                      Click="ToGroupContextMenu_MoveToFolder_Click"/>
            <MenuItem Header="_Copy to Folder…"
                      AutomationProperties.Name="Copy Recipient Group to Folder"
                      Click="ToGroupContextMenu_CopyToFolder_Click"/>
            <MenuItem Header="Sa_ve Messages As…"
                      AutomationProperties.Name="Save Messages to Recipient As"
                      Click="MenuSaveAs_Click"/>
            <Separator/>
            <MenuItem Header="_Delete All to Recipient"
                      AutomationProperties.Name="Delete All to Recipient"
                      Command="{Binding DeleteToGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Arc_hive All to Recipient"
                      AutomationProperties.Name="Archive All to Recipient"
                      Command="{Binding ArchiveToGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Flag_s"
                      Tag="FlagsSubmenu"
                      AutomationProperties.Name="Flags"/>
            <Separator/>
            <MenuItem Header="E_xpand Group"
                      AutomationProperties.Name="Expand Group"
                      Command="{Binding ExpandToGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Colla_pse Group"
                      AutomationProperties.Name="Collapse Group"
                      Command="{Binding CollapseToGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="_Expand All Groups"
                      AutomationProperties.Name="Expand All Groups"
                      Command="{Binding ExpandAllToGroupsCommand}"/>
            <MenuItem Header="Collapse A_ll Groups"
                      AutomationProperties.Name="Collapse All Groups"
                      Command="{Binding CollapseAllToGroupsCommand}"/>
        </ContextMenu>

        <!-- Conversation-group context menu (root level of ConversationTree) -->
        <ContextMenu x:Key="ConversationGroupContextMenu"
                     AutomationProperties.Name="Conversation actions"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="_Reply"
                      AutomationProperties.Name="Reply"
                      Command="{Binding ReplyConversationCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Reply _All"
                      AutomationProperties.Name="Reply All"
                      Command="{Binding ReplyAllConversationCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="_Forward"
                      AutomationProperties.Name="Forward"
                      Command="{Binding ForwardConversationCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="_Move to Folder…"
                      AutomationProperties.Name="Move Conversation to Folder"
                      Click="ConversationContextMenu_MoveToFolder_Click"/>
            <MenuItem Header="_Copy to Folder…"
                      AutomationProperties.Name="Copy Conversation to Folder"
                      Click="ConversationContextMenu_CopyToFolder_Click"/>
            <MenuItem Header="Sa_ve Conversation As…"
                      AutomationProperties.Name="Save Conversation As"
                      Click="MenuSaveAs_Click"/>
            <Separator/>
            <MenuItem Header="_Delete Conversation"
                      AutomationProperties.Name="Delete Conversation"
                      Command="{Binding DeleteConversationCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Arc_hive Conversation"
                      AutomationProperties.Name="Archive Conversation"
                      Command="{Binding ArchiveConversationCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Flag_s"
                      Tag="FlagsSubmenu"
                      AutomationProperties.Name="Flags"/>
            <Separator/>
            <MenuItem Header="E_xpand Conversation"
                      AutomationProperties.Name="Expand Conversation"
                      Command="{Binding ExpandConversationCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Colla_pse Conversation"
                      AutomationProperties.Name="Collapse Conversation"
                      Command="{Binding CollapseConversationCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="_Expand All Conversations"
                      AutomationProperties.Name="Expand All Conversations"
                      Command="{Binding ExpandAllConversationsCommand}"/>
            <MenuItem Header="Collapse A_ll Conversations"
                      AutomationProperties.Name="Collapse All Conversations"
                      Command="{Binding CollapseAllConversationsCommand}"/>
        </ContextMenu>

        <!-- Individual-message context menu (MessageList and child nodes in ConversationTree) -->
        <ContextMenu x:Key="MessageContextMenu"
                     AutomationProperties.Name="Message actions"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="_Reply"
                      AutomationProperties.Name="Reply"
                      Command="{Binding ReplyCommand}"/>
            <MenuItem Header="Reply _All"
                      AutomationProperties.Name="Reply All"
                      Command="{Binding ReplyAllCommand}"/>
            <MenuItem Header="_Forward"
                      AutomationProperties.Name="Forward"
                      Command="{Binding ForwardCommand}"/>
            <Separator/>
            <MenuItem Header="_Move to Folder…"
                      AutomationProperties.Name="Move to Folder"
                      Click="MessageContextMenu_MoveToFolder_Click"/>
            <MenuItem Header="_Copy to Folder…"
                      AutomationProperties.Name="Copy to Folder"
                      Click="MessageContextMenu_CopyToFolder_Click"/>
            <MenuItem Header="Sa_ve As…"
                      InputGestureText="F12"
                      AutomationProperties.Name="Save As"
                      Click="MenuSaveAs_Click"/>
            <MenuItem Header="_Print…"
                      InputGestureText="Ctrl+P"
                      AutomationProperties.Name="Print"
                      Click="MenuPrint_Click"/>
            <Separator/>
            <MenuItem Header="_Delete"
                      AutomationProperties.Name="Delete"
                      Click="MessageContextMenu_Delete_Click"/>
            <MenuItem Header="Move to Arc_hive"
                      InputGestureText="Ctrl+Shift+M"
                      AutomationProperties.Name="Move to Archive"
                      Click="MessageContextMenu_Archive_Click"/>
            <Separator/>
            <MenuItem Header="Mark as R_ead"
                      InputGestureText="Ctrl+Q"
                      AutomationProperties.Name="Mark as Read"
                      Click="MessageContextMenu_MarkRead_Click"/>
            <MenuItem Header="Mark as _Unread"
                      InputGestureText="Ctrl+U"
                      AutomationProperties.Name="Mark as Unread"
                      Click="MessageContextMenu_MarkUnread_Click"/>
            <MenuItem Header="Flag_s"
                      Tag="FlagsSubmenu"
                      AutomationProperties.Name="Flags"/>
            <!-- Taken out of the menu, with its separator, on a shared mailbox's message (#678): see ShowCreateRuleItem. -->
            <Separator Tag="CreateRuleSeparator"/>
            <MenuItem Header="Crea_te Rule from Message…"
                      Tag="CreateRuleItem"
                      InputGestureText="Ctrl+Shift+T"
                      AutomationProperties.Name="Create Rule from Message"
                      AutomationProperties.AcceleratorKey="Ctrl+Shift+T"
                      Command="{Binding CreateRuleFromMessageCommand}"/>
        </ContextMenu>

        <!-- Folder context menu — MUST live in Window.Resources, not inside a Style.Setter.Value.
             The WPF XAML compiler generates incorrect type casts for Click handlers inside
             Style setters (it emits GridSplitter instead of MenuItem), causing an APPCRASH. -->
        <ContextMenu x:Key="FolderContextMenu"
                     AutomationProperties.Name="Folder actions">
            <MenuItem Header="_New Folder…"
                      AutomationProperties.Name="New Folder"
                      Click="FolderContextMenu_NewFolder_Click"/>
            <Separator/>
            <MenuItem Header="_Move Folder…"
                      AutomationProperties.Name="Move Folder"
                      Click="FolderContextMenu_MoveFolder_Click"/>
            <MenuItem Header="_Copy Folder…"
                      AutomationProperties.Name="Copy Folder"
                      Click="FolderContextMenu_CopyFolder_Click"/>
            <Separator/>
            <MenuItem Header="Set as _Archive Folder"
                      AutomationProperties.Name="Set as Archive Folder"
                      Click="FolderContextMenu_SetArchive_Click"/>
            <MenuItem Header="Use A_utomatic Archive Folder"
                      AutomationProperties.Name="Use Automatic Archive Folder"
                      Click="FolderContextMenu_ClearArchive_Click"/>
            <Separator/>
            <!-- #516. N, M, C, A, U and D are taken by the items above — note U, from "Use A_utomatic
                 Archive Folder" — leaving S and F. WPF cycles between duplicate access keys instead
                 of invoking, so a collision here would make the key highlight rather than activate. -->
            <MenuItem Header="Set as _Startup Folder"
                      AutomationProperties.Name="Set as Startup Folder"
                      Click="FolderContextMenu_SetStartupFolder_Click"/>
            <MenuItem Header="Clear Startup _Folder"
                      AutomationProperties.Name="Clear Startup Folder"
                      Click="FolderContextMenu_ClearStartupFolder_Click"/>
            <Separator/>
            <MenuItem Header="_Delete Folder"
                      AutomationProperties.Name="Delete Folder"
                      Click="FolderContextMenu_DeleteFolder_Click"/>
            <Separator/>
            <!-- #590. Access keys still free after the items above (N, M, C, A, U, S, F, D): X, P,
                 E and L. Both single-folder items act on the whole branch, not one level — Right
                 and Left arrow already do one level. -->
            <MenuItem Header="E_xpand Folder"
                      AutomationProperties.Name="Expand Folder"
                      Click="FolderContextMenu_ExpandFolder_Click"/>
            <MenuItem Header="Colla_pse Folder"
                      AutomationProperties.Name="Collapse Folder"
                      Click="FolderContextMenu_CollapseFolder_Click"/>
            <MenuItem Header="_Expand All Folders"
                      AutomationProperties.Name="Expand All Folders"
                      Click="FolderContextMenu_ExpandAllFolders_Click"/>
            <MenuItem Header="Collapse A_ll Folders"
                      AutomationProperties.Name="Collapse All Folders"
                      Click="FolderContextMenu_CollapseAllFolders_Click"/>
        </ContextMenu>

        <!-- Calendar context menu — replaces FolderContextMenu on the Calendar node and its
             children (issue #497). None of the mail folder actions apply to a calendar; every one
             of them silently did nothing there. Same Window.Resources rule as above: a ContextMenu
             with Click handlers must not be declared inside a Style setter. -->
        <ContextMenu x:Key="CalendarContextMenu"
                     AutomationProperties.Name="Calendar actions"
                     Opened="CalendarContextMenu_Opened">
            <MenuItem Header="Use as _Default Calendar for New Appointments"
                      AutomationProperties.Name="Use as Default Calendar for New Appointments"
                      Click="CalendarContextMenu_SetDefault_Click"/>
            <MenuItem Header="_Clear Default Calendar"
                      AutomationProperties.Name="Clear Default Calendar"
                      Click="CalendarContextMenu_ClearDefault_Click"/>
            <MenuItem Header="_Import Calendar File (.ics)…"
                      AutomationProperties.Name="Import Calendar File"
                      Click="MenuImportCalendarFile_Click"/>
            <Separator/>
            <!-- #590. Calendar nodes sit in the same tree and nest the same way, so they get the
                 same expansion actions — worded for a calendar, since "Expand Folder" on the
                 Calendar node would name something the user is not looking at. -->
            <MenuItem Header="E_xpand Calendar"
                      AutomationProperties.Name="Expand Calendar"
                      Click="FolderContextMenu_ExpandFolder_Click"/>
            <MenuItem Header="Colla_pse Calendar"
                      AutomationProperties.Name="Collapse Calendar"
                      Click="FolderContextMenu_CollapseFolder_Click"/>
            <MenuItem Header="_Expand All Folders"
                      AutomationProperties.Name="Expand All Folders"
                      Click="FolderContextMenu_ExpandAllFolders_Click"/>
            <MenuItem Header="Collapse A_ll Folders"
                      AutomationProperties.Name="Collapse All Folders"
                      Click="FolderContextMenu_CollapseAllFolders_Click"/>
            <Separator/>
            <!-- Where Calendar sits among the folder roots. Checkable so the current choice is
                 reported by the platform on open — no custom announcement for state that a menu
                 item's own check already carries. Tag is what CalendarContextMenu_Opened matches
                 on: a ContextMenu in Window.Resources has its own name scope, so x:Name here does
                 not give the code-behind a field to reach. Access keys D, C, X, P, E and L are
                 taken by the items above, leaving T and B. -->
            <MenuItem Header="Calendar at _Top of Folder List"
                      AutomationProperties.Name="Calendar at Top of Folder List"
                      Tag="calendarFirst" IsCheckable="True"
                      Click="CalendarContextMenu_CalendarFirst_Click"/>
            <MenuItem Header="Calendar at _Bottom of Folder List"
                      AutomationProperties.Name="Calendar at Bottom of Folder List"
                      Tag="calendarLast" IsCheckable="True"
                      Click="CalendarContextMenu_CalendarLast_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Window.InputBindings>
        <!-- Navigation shortcuts not in the command registry are handled directly in PreviewKeyDown. -->
        <!-- Action command shortcuts are routed through the CommandRegistry in OnWindowKeyDown.     -->
    </Window.InputBindings>


    <!-- MailBox MatriX layout: sidebar | message list | splitter | scenic main area.
         Row 0 is the Alt-revealed menu bar (zero height until the menus have keyboard focus),
         row 2 the status strip under the list. MbxWindowFrame pads the maximized window.

         Glass layering, back to front: ONE picture behind the whole window (MbxBackdrop; themes
         will swap it); the sidebar is blue glass over a blurred, aligned copy of it (Theme.SidebarTint);
         the list header is opaque; the list body (Theme.ListSurface) and the reading surface
         (Theme.ReadingSurface) are ~90% opaque, so the picture shows faintly through them. -->
    <Border x:Name="MbxWindowFrame">
    <Grid x:Name="MbxRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="17*" MinWidth="220"/>
            <ColumnDefinition x:Name="MessageListColumn" Width="39*" MinWidth="320"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="44*" MinWidth="380"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Alt-revealed menu bar -->
            <RowDefinition Height="*"/>     <!-- Content -->
            <RowDefinition Height="Auto"/>  <!-- Status strip (list column) -->
        </Grid.RowDefinitions>

        <!-- The picture behind the whole app: one continuous image (UniformToFill, never tiled).
             Drawn as a brush so its crop is exactly the window; the sidebar repeats the same brush
             at the same size and origin, so its blurred copy lines up. Off under High Contrast. -->
        <Border x:Name="MbxBackdrop" Grid.RowSpan="3" Grid.ColumnSpan="4"
                Background="{DynamicResource Theme.MainAreaBackground}" IsHitTestVisible="False">
            <Border x:Name="ScenicImage" Opacity="{DynamicResource Theme.ImageryOpacity}">
                <Border.Background>
                    <ImageBrush ImageSource="{DynamicResource Mbx.ScenicImageSource}"
                                Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
                </Border.Background>
            </Border>
        </Border>

        <Menu x:Name="MainMenuBar"
              Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Panel.ZIndex="20"
              Height="0" ClipToBounds="True"
              IsTabStop="False"
              KeyboardNavigation.TabNavigation="None"
              AutomationProperties.Name="Main menu">

            <!-- File -->
            <MenuItem Header="_File" SubmenuOpened="FileMenu_SubmenuOpened">
                <MenuItem Header="_New Message"
                          Command="{Binding NewMessageCommand}"
                          InputGestureText="Ctrl+N"/>
                <Separator/>
                <!-- Save, Save As, Print (#728). Click, not Command: what they act on (a multi-selection,
                     a group header's messages) is resolved by the window. Dimmed rather than disabled,
                     like the Message menu's filing items, so they stay keyboard-navigable;
                     HasMessageTarget is recomputed as this menu opens (FileMenu_SubmenuOpened). -->
                <MenuItem Header="_Save"
                          InputGestureText="Ctrl+S"
                          Click="MenuSave_Click">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMessageTarget}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextDisabled}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <MenuItem Header="Save _As…"
                          InputGestureText="F12"
                          Click="MenuSaveAs_Click">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMessageTarget}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextDisabled}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <MenuItem Header="_Print…"
                          InputGestureText="Ctrl+P"
                          Click="MenuPrint_Click">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMessageTarget}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextDisabled}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Import Calendar File (.ics)…"
                          AutomationProperties.Name="Import Calendar File"
                          Click="MenuImportCalendarFile_Click"/>
                <Separator/>
                <MenuItem Header="_Manage Accounts…"
                          Command="{Binding ManageAccountsCommand}"/>
                <Separator/>
                <MenuItem Header="S_ettings…"
                          Click="MenuSettings_Click"
                          InputGestureText="Ctrl+,"/>
                <Separator/>
                <MenuItem Header="E_xit"
                          Command="{Binding ExitCommand}"/>
            </MenuItem>

            <!-- Message -->
            <MenuItem Header="_Message" SubmenuOpened="MessageMenu_SubmenuOpened">
                <MenuItem Header="_Reply"
                          Command="{Binding ReplyCommand}"
                          InputGestureText="Ctrl+R"/>
                <MenuItem Header="Reply _All"
                          Command="{Binding ReplyAllCommand}"
                          InputGestureText="Ctrl+Shift+R"/>
                <MenuItem Header="_Forward"
                          Command="{Binding ForwardCommand}"
                          InputGestureText="Ctrl+Shift+F"/>
                <Separator/>
                <MenuItem Header="_Delete"
                          Command="{Binding DeleteMessageCommand}"
                          InputGestureText="Del"/>
                <MenuItem Header="Move to Arc_hive"
                          Command="{Binding ArchiveMessageCommand}"
                          InputGestureText="Ctrl+Shift+M"/>
                <MenuItem Header="Empty _Trash"
                          Command="{Binding EmptyTrashCommand}"
                          InputGestureText="Ctrl+Shift+E"/>
                <!-- No gesture: the Outbox drains on its own when the connection returns (#637). -->
                <MenuItem Header="Send _Outbox Now"
                          Command="{Binding SendOutboxNowCommand}"/>
                <Separator/>
                <!-- Click, not Command: the target depends on which group tree is selected, which
                     only the window can resolve (see WatchTargetSubject). Dimmed rather than
                     disabled, per the convention above, so it stays keyboard-navigable. -->
                <MenuItem Header="_Watch Conversation"
                          IsCheckable="True"
                          IsChecked="{Binding IsWatchTargetWatched, Mode=OneWay}"
                          Click="MenuWatchConversation_Click"
                          InputGestureText="Ctrl+Shift+W">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasWatchTarget}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextDisabled}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <Separator/>
                <!-- Keep IsEnabled off these three items so they remain keyboard-navigable
                     per Windows convention (dimmed items are still focusable). Visual dimming
                     is applied via DataTrigger; the Click handlers guard against invalid state. -->
                <!-- HasMessageTarget, not HasSelectedMessage: these also file a selected conversation,
                     whose header selection leaves SelectedMessage untouched (issue #566). It is
                     recomputed in MessageMenu_SubmenuOpened, as HasWatchTarget above is. -->
                <MenuItem Header="_Move to Folder…"
                          Click="MenuMoveToFolder_Click">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMessageTarget}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextDisabled}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <MenuItem Header="_Copy to Folder…"
                          Click="MenuCopyToFolder_Click">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMessageTarget}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextDisabled}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Grab Addresses from Message"
                          Click="MenuGrabAddresses_Click"
                          InputGestureText="Ctrl+Shift+G">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMessageOpen}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextDisabled}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <!-- Until now only on the message list's context menu. Click, not Command, so it stays
                     keyboard-navigable when it cannot act, and says why (a shared mailbox's message, #678)
                     rather than doing nothing. "u" because Empty Trash already has "t" on this menu. -->
                <MenuItem Header="Create R_ule from Message…"
                          Click="MenuCreateRule_Click"
                          InputGestureText="Ctrl+Shift+T"
                          AutomationProperties.Name="Create Rule from Message">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMessageTarget}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextDisabled}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
            </MenuItem>

            <!-- Folder -->
            <MenuItem Header="Fol_der">
                <MenuItem Header="_New Folder…"
                          Click="MenuNewFolder_Click"
                          AutomationProperties.Name="New Folder"/>
                <Separator/>
                <!-- #590. These act on the folder tree's selection, so they work the same whether
                     the user got here from the menu bar or from the tree's own context menu. -->
                <MenuItem Header="E_xpand Folder"
                          Click="MenuExpandFolder_Click"
                          AutomationProperties.Name="Expand Folder"/>
                <MenuItem Header="Colla_pse Folder"
                          Click="MenuCollapseFolder_Click"
                          AutomationProperties.Name="Collapse Folder"/>
                <MenuItem Header="_Expand All Folders"
                          Click="MenuExpandAllFolders_Click"
                          AutomationProperties.Name="Expand All Folders"/>
                <MenuItem Header="Collapse A_ll Folders"
                          Click="MenuCollapseAllFolders_Click"
                          AutomationProperties.Name="Collapse All Folders"/>
            </MenuItem>

            <!-- View -->
            <MenuItem Header="_View">
                <MenuItem Header="_Refresh"
                          Command="{Binding RefreshCommand}"
                          InputGestureText="F5"/>
                <Separator/>
                <MenuItem Header="_Plain Text View"
                          IsCheckable="True"
                          IsChecked="{Binding ReadAsPlainText, Mode=OneWay}"
                          Click="MenuPlainText_Click"
                          InputGestureText="Ctrl+Shift+H"/>
                <MenuItem Header="_Load Pictures"
                          Click="MenuLoadPictures_Click"
                          InputGestureText="Ctrl+Shift+U"/>
                <Separator/>
                <!-- Only the four modes that apply are in the tree at all (#663) — see
                     ViewModeMenuItemStyle. -->
                <MenuItem Header="View _Mode"
                          x:Name="ViewModeMenuItem"
                          ItemsSource="{Binding ViewModeOptions}"
                          ItemContainerStyle="{StaticResource ViewModeMenuItemStyle}"/>
                <!-- Density (#421): the same setting as Settings → Appearance,
                     adjustable in place. Padding only — never the accessibility
                     surface. Registered as view.density.* for palette/hotkeys. -->
                <MenuItem Header="_Density">
                    <MenuItem Header="_Comfortable"
                              IsCheckable="True"
                              IsChecked="{Binding IsListDensityComfortable, Mode=OneWay}"
                              Command="{Binding SetListDensityCommand}"
                              CommandParameter="comfortable"/>
                    <MenuItem Header="Co_mpact"
                              IsCheckable="True"
                              IsChecked="{Binding IsListDensityCompact, Mode=OneWay}"
                              Command="{Binding SetListDensityCommand}"
                              CommandParameter="compact"/>
                </MenuItem>
                <!-- Which fields each kind of list row speaks, and in what order.
                     Registered as view.rowFields; opened modeless. -->
                <MenuItem x:Name="RowFieldsMenuItem"
                          Header="Message List Fi_elds…"/>
                <MenuItem Header="F_ilter">
                    <MenuItem Header="S_how All"
                              IsCheckable="True"
                              IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="all"/>
                    <Separator/>
                    <MenuItem Header="_Unread"
                              IsCheckable="True"
                              IsChecked="{Binding IsFilterUnread, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="unread"/>
                    <MenuItem Header="_Read"
                              IsCheckable="True"
                              IsChecked="{Binding IsFilterRead, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="read"/>
                    <Separator/>
                    <MenuItem Header="With _Attachments"
                              IsCheckable="True"
                              IsChecked="{Binding IsFilterWithAttachments, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="attachments"/>
                    <MenuItem Header="Re_plied"
                              IsCheckable="True"
                              IsChecked="{Binding IsFilterReplied, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="replied"/>
                    <MenuItem Header="_Forwarded"
                              IsCheckable="True"
                              IsChecked="{Binding IsFilterForwarded, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="forwarded"/>
                    <Separator/>
                    <MenuItem Header="To _Me"
                              IsCheckable="True"
                              IsChecked="{Binding IsFilterToMe, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="tome"/>
                    <MenuItem Header="_Watched"
                              IsCheckable="True"
                              IsChecked="{Binding IsFilterWatched, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="watched"/>
                    <Separator/>
                    <MenuItem x:Name="FilterFlaggedItem"
                              Header="Fla_gged"
                              IsChecked="{Binding IsFilterFlagged, Mode=OneWay}">
                        <MenuItem Header="All Fla_gged"
                                  IsCheckable="True"
                                  IsChecked="{Binding IsFilterAllFlagged, Mode=OneWay}"
                                  Command="{Binding SetFilterCommand}"
                                  CommandParameter="flagged"/>
                        <Separator x:Name="FilterFlaggedSeparator"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="S_ort">
                    <MenuItem Header="Newest _First"
                              IsCheckable="True"
                              IsChecked="{Binding IsSortDateDesc, Mode=OneWay}"
                              Command="{Binding SetSortCommand}"
                              CommandParameter="dateDesc"/>
                    <MenuItem Header="_Oldest First"
                              IsCheckable="True"
                              IsChecked="{Binding IsSortDateAsc, Mode=OneWay}"
                              Command="{Binding SetSortCommand}"
                              CommandParameter="dateAsc"/>
                    <Separator/>
                    <MenuItem Header="_A → Z"
                              IsCheckable="True"
                              IsChecked="{Binding IsSortAlphaAsc, Mode=OneWay}"
                              Command="{Binding SetSortCommand}"
                              CommandParameter="alphaAsc"/>
                    <MenuItem Header="_Z → A"
                              IsCheckable="True"
                              IsChecked="{Binding IsSortAlphaDesc, Mode=OneWay}"
                              Command="{Binding SetSortCommand}"
                              CommandParameter="alphaDesc"/>
                    <Separator/>
                    <MenuItem Header="Fla_gged First"
                              IsCheckable="True"
                              IsChecked="{Binding IsSortFlaggedFirst, Mode=OneWay}"
                              Command="{Binding SetSortCommand}"
                              CommandParameter="flaggedFirst"/>
                    <Separator/>
                    <MenuItem Header="_Most Messages"
                              IsCheckable="True"
                              IsChecked="{Binding IsSortCountDesc, Mode=OneWay}"
                              IsEnabled="{Binding IsCountSortAvailable}"
                              Command="{Binding SetSortCommand}"
                              CommandParameter="countDesc"/>
                    <MenuItem Header="Fe_west Messages"
                              IsCheckable="True"
                              IsChecked="{Binding IsSortCountAsc, Mode=OneWay}"
                              IsEnabled="{Binding IsCountSortAvailable}"
                              Command="{Binding SetSortCommand}"
                              CommandParameter="countAsc"/>
                </MenuItem>
                <MenuItem Header="_Views" x:Name="ViewsMenuItem">
                    <!-- Dynamic view items inserted by code-behind -->
                    <Separator x:Name="ViewsMenuSeparator" Visibility="Collapsed"/>
                    <MenuItem Header="_Save View…"
                              Command="{Binding SaveViewCommand}"
                              AutomationProperties.Name="Save current state as a view"/>
                    <MenuItem Header="_Manage Views…"
                              Command="{Binding ManageViewsCommand}"
                              AutomationProperties.Name="Open View Manager"/>
                    <MenuItem Header="_Clear View"
                              Command="{Binding ClearViewCommand}"
                              AutomationProperties.Name="Clear View"/>
                    <MenuItem Header="_Reset Folder View"
                              Command="{Binding ResetFolderViewCommand}"
                              AutomationProperties.Name="Reset Folder View"/>
                </MenuItem>
                <MenuItem Header="S_ync Range">
                    <MenuItem Header="Last _7 Days"
                              IsCheckable="True"
                              IsChecked="{Binding IsSyncDays7, Mode=OneWay}"
                              Command="{Binding SetSyncDaysCommand}"
                              CommandParameter="7"/>
                    <MenuItem Header="Last _30 Days"
                              IsCheckable="True"
                              IsChecked="{Binding IsSyncDays30, Mode=OneWay}"
                              Command="{Binding SetSyncDaysCommand}"
                              CommandParameter="30"/>
                    <MenuItem Header="Last _6 Months"
                              IsCheckable="True"
                              IsChecked="{Binding IsSyncDays180, Mode=OneWay}"
                              Command="{Binding SetSyncDaysCommand}"
                              CommandParameter="180"/>
                    <MenuItem Header="Last _1 Year"
                              IsCheckable="True"
                              IsChecked="{Binding IsSyncDays365, Mode=OneWay}"
                              Command="{Binding SetSyncDaysCommand}"
                              CommandParameter="365"/>
                    <Separator/>
                    <MenuItem Header="_All Mail"
                              IsCheckable="True"
                              IsChecked="{Binding IsSyncDaysAll, Mode=OneWay}"
                              Command="{Binding SetSyncDaysCommand}"
                              CommandParameter="0"/>
                </MenuItem>
                <Separator/>
                <!-- Moved from Tools: choosing how the app looks belongs on View.
                     Next/Previous Theme remain palette commands (theme.next/previous)
                     without menu items, per design. -->
                <MenuItem Header="Manage _Themes…"
                          Click="MenuManageThemes_Click"
                          AutomationProperties.Name="Manage Themes"/>
                <!-- MailBox MatriX: contextual pictures behind message rows (chosen locally). -->
                <MenuItem x:Name="ContextImagesMenuItem"
                          Header="Pictures _Behind Messages"
                          IsCheckable="True"
                          Click="MenuContextImages_Click"
                          AutomationProperties.Name="Pictures Behind Messages"/>
                <Separator/>
                <MenuItem Header="Go to _Folder…"
                          Click="MenuFolderPicker_Click"/>
                <MenuItem Header="_Search Folders…"
                          Click="MenuSearchFolders_Click"
                          InputGestureText="Ctrl+Shift+Y"/>
                <MenuItem Header="_Advanced Search…"
                          Click="MenuAdvancedSearch_Click"
                          InputGestureText="Ctrl+/"/>
            </MenuItem>

            <!-- Tools — always available (mirrors the Compose window's Tools menu).
                 Each command lives here only; not duplicated in File/Message/View. -->
            <MenuItem Header="_Tools">
                <MenuItem Header="Address _Book…"
                          Click="MenuAddressBook_Click"
                          InputGestureText="Ctrl+Shift+B"/>
                <MenuItem Header="_Rules…"
                          Command="{Binding OpenRulesManagerCommand}"
                          InputGestureText="Ctrl+Shift+L"
                          AutomationProperties.Name="Manage Rules"
                          AutomationProperties.AcceleratorKey="Ctrl+Shift+L"/>
                <!-- The manager belongs here with the other managers, not beside Watch
                     Conversation on the Message menu: that one acts on the selected message,
                     this one is a surface for reviewing what you have accumulated. Same split
                     as toggling a flag versus managing flags. -->
                <MenuItem Header="_Watched Conversations…"
                          Click="MenuWatchedConversations_Click"
                          AutomationProperties.Name="Watched Conversations"/>
                <Separator/>
                <MenuItem Header="Command _Palette…"
                          Click="MenuCommandPalette_Click"
                          InputGestureText="Ctrl+Shift+P"/>
            </MenuItem>

            <!-- Help -->
            <MenuItem Header="_Help">
                <MenuItem Header="{Binding UpdateAvailableText, Mode=OneWay}"
                          Command="{Binding OpenUpdatePageCommand}"/>
                <!-- Only on an ARM64 PC running the x64 build: nothing migrates an install
                     across architectures, so this entry is how those users find the native
                     build. Hidden everywhere else. -->
                <MenuItem Header="Get the ARM _Version"
                          AutomationProperties.Name="Get the ARM Version"
                          Visibility="{Binding IsNativeArmAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                          Command="{Binding OpenArmDownloadPageCommand}"/>
                <Separator/>
                <MenuItem Header="User _Guide"
                          Command="{Binding ViewUserGuideCommand}"
                          InputGestureText="F1"/>
                <MenuItem Header="_Keyboard Tutorial"
                          AutomationProperties.Name="Keyboard Tutorial"
                          Click="MenuKeyboardTutorial_Click"/>
                <Separator/>
                <MenuItem Header="_Report a Bug"
                          AutomationProperties.Name="Report a Bug"
                          Click="MenuReportBug_Click"/>
                <MenuItem Header="Connection _Diagnostics"
                          AutomationProperties.Name="Connection Diagnostics"
                          Visibility="{Binding IsConnectionDiagnosticsEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                          Click="MenuConnectionDiagnostics_Click"/>
                <Separator/>
                <!-- #607: one-time org setup for a Global Admin — grants QuickMail's Graph permissions
                     tenant-wide so users then sign in with no consent prompts. -->
                <MenuItem Header="Grant Admin _Consent for Your Organization…"
                          AutomationProperties.Name="Grant Admin Consent for Your Organization"
                          Click="MenuAdminConsent_Click"/>
                <Separator/>
                <MenuItem Header="_About MailBox MatriX"
                          AutomationProperties.Name="About MailBox MatriX"
                          Click="MenuAbout_Click"/>
            </MenuItem>

        </Menu>

        <!-- ── Sidebar: full height, blue. Accounts on top, folders below. ──
             The account list and folder tree are QuickMail's own controls, unchanged: the
             Theme.* brushes they use are re-pointed at the Sidebar* tokens for this scope only,
             through the published ".Color" resources, so they follow every theme switch. -->
        <Grid x:Name="Sidebar" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
              TextElement.Foreground="{DynamicResource Theme.SidebarText}">
            <Grid.Resources>
                <SolidColorBrush x:Key="Theme.SurfaceBackground"   Color="Transparent"/>
                <SolidColorBrush x:Key="Theme.ChromeBackground"    Color="Transparent"/>
                <SolidColorBrush x:Key="Theme.Border"              Color="Transparent"/>
                <SolidColorBrush x:Key="Theme.TextPrimary"         Color="{DynamicResource Theme.SidebarText.Color}"/>
                <SolidColorBrush x:Key="Theme.TextSecondary"       Color="{DynamicResource Theme.SidebarTextSecondary.Color}"/>
                <SolidColorBrush x:Key="Theme.TextDisabled"        Color="{DynamicResource Theme.SidebarTextSecondary.Color}"/>
                <SolidColorBrush x:Key="Theme.SelectionBackground" Color="{DynamicResource Theme.SidebarSelection.Color}"/>
                <SolidColorBrush x:Key="Theme.SelectionInactive"   Color="{DynamicResource Theme.SidebarSelection.Color}"/>
                <SolidColorBrush x:Key="Theme.SelectionText"       Color="{DynamicResource Theme.SidebarText.Color}"/>
                <SolidColorBrush x:Key="Theme.AccentSubtle"        Color="{DynamicResource Theme.SidebarHover.Color}"/>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>                 <!-- title, hamburger, New mail -->
                <RowDefinition Height="Auto"/>                 <!-- Accounts header -->
                <RowDefinition Height="Auto" MaxHeight="260"/> <!-- account list -->
                <RowDefinition Height="Auto"/>                 <!-- Folders header -->
                <RowDefinition Height="*"/>                    <!-- main folders + More, or the full tree -->
                <RowDefinition Height="Auto"/>                 <!-- profile -->
            </Grid.RowDefinitions>

            <!-- Glass: the window's picture, blurred, under the blue tint (Windows 10 Mail's acrylic).
                 The copy is the full window's size at the window's origin (the sidebar starts there),
                 clipped to the sidebar, so it lines up with the picture beside it.
                 Imagery is off under High Contrast, leaving the opaque sidebar colour. -->
            <Rectangle Grid.RowSpan="6" Fill="{DynamicResource Theme.SidebarBackground}"/>
            <Canvas Grid.RowSpan="6" ClipToBounds="True" IsHitTestVisible="False">
                <Border x:Name="SidebarGlassPicture"
                        Width="{Binding ActualWidth, ElementName=MbxRoot}"
                        Height="{Binding ActualHeight, ElementName=MbxRoot}"
                        Opacity="{DynamicResource Theme.ImageryOpacity}">
                    <Border.Background>
                        <ImageBrush ImageSource="{DynamicResource Mbx.ScenicImageSource}"
                                    Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
                    </Border.Background>
                    <Border.Effect>
                        <BlurEffect Radius="27" KernelType="Gaussian" RenderingBias="Performance"/>
                    </Border.Effect>
                </Border>
            </Canvas>
            <Rectangle Grid.RowSpan="6" Fill="{DynamicResource Theme.SidebarTint}"/>

            <!-- App title (also a window drag area), the hamburger, and New mail. -->
            <StackPanel Grid.Row="0" Margin="0,0,0,4">
                <Border Background="Transparent" Padding="14,12,14,8"
                        MouseLeftButtonDown="CaptionDragArea_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal">
                        <local:AriaHiddenTextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{DynamicResource Theme.FontSizeHeader}"
                                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="SidebarTitle" Text="MailBox MatriX" FontSize="{DynamicResource Theme.FontSizeHeader}"
                                   FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Focusable="False"
                                   Visibility="{Binding IsSidebarCompact, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
                <Button x:Name="SidebarHamburgerButton"
                        Style="{StaticResource Mbx.SidebarButton}"
                        Command="{Binding ToggleSidebarCompactCommand}"
                        AutomationProperties.Name="Navigation pane"
                        ToolTip="Collapse or expand the navigation pane">
                    <local:AriaHiddenTextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="{DynamicResource Theme.FontSizeLarge}"
                                               VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="SidebarNewMailButton"
                        Style="{StaticResource Mbx.SidebarButton}"
                        Command="{Binding NewMessageCommand}"
                        AutomationProperties.Name="New mail"
                        AutomationProperties.AcceleratorKey="Ctrl+N"
                        ToolTip="New mail (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <local:AriaHiddenTextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{DynamicResource Theme.FontSizeLarge}"
                                                   VerticalAlignment="Center"/>
                        <TextBlock Text="New mail" FontSize="{DynamicResource Theme.FontSizeLarge}"
                                   Margin="14,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsSidebarCompact, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Button>

                <!-- Mailboxes: every account's mail in one list (the combined All Mail view), and the
                     folder list switches to combined folders with totals. Shown as selected while a
                     combined view is open; the accounts below open one account's Inbox each. -->
                <Button x:Name="SidebarAllMailButton" Margin="0,14,0,0"
                        Command="{Binding OpenAllMailCommand}"
                        AutomationProperties.Name="Mailboxes"
                        ToolTip="Mail from every account">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Mbx.SidebarButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCombinedFolderView}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Theme.SidebarSelection}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <local:AriaHiddenTextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{DynamicResource Theme.FontSizeLarge}"
                                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Mailboxes" FontSize="{DynamicResource Theme.FontSizeLarge}"
                                   Margin="14,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsSidebarCompact, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Accounts header: icon, label, and a chevron that folds the account list away. -->
            <DockPanel Grid.Row="1" Margin="14,14,6,2"
                       Visibility="{Binding IsSidebarCompact, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Button x:Name="AccountsChevronButton" DockPanel.Dock="Right" Padding="10,6"
                        Command="{Binding ToggleAccountListCommand}"
                        ToolTip="Show or hide the accounts">
                    <local:AriaHiddenTextBlock FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center">
                        <local:AriaHiddenTextBlock.Style>
                            <Style TargetType="local:AriaHiddenTextBlock">
                                <Setter Property="Text" Value="&#xE70E;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAccountListExpanded}" Value="False">
                                        <Setter Property="Text" Value="&#xE70D;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:AriaHiddenTextBlock.Style>
                    </local:AriaHiddenTextBlock>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Mbx.SidebarButton}">
                            <Setter Property="AutomationProperties.Name" Value="Collapse accounts"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAccountListExpanded}" Value="False">
                                    <Setter Property="AutomationProperties.Name" Value="Expand accounts"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <local:AriaHiddenTextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="{DynamicResource Theme.FontSizeLarge}" VerticalAlignment="Center"/>
                    <TextBlock Text="Accounts" FontSize="{DynamicResource Theme.FontSizeLarge}"
                               Margin="14,0,0,0" VerticalAlignment="Center" Focusable="False"/>
                </StackPanel>
            </DockPanel>

                <!-- One line per account: provider badge, name, unread count on the right. The full
                     status (connected, unread) stays in the accessible name and the tooltip. -->
                <ListBox Grid.Row="2"
                         x:Name="AccountList"
                         AutomationProperties.Name="Email accounts"
                         ItemsSource="{Binding Accounts}"
                         SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                         TextSearch.TextPath="AccountLabel"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         TabIndex="1"
                         KeyboardNavigation.TabNavigation="Once"
                         GotKeyboardFocus="List_GotKeyboardFocus"
                         PreviewKeyDown="AccountList_PreviewKeyDown"
                         PreviewMouseLeftButtonDown="AccountList_PreviewMouseLeftButtonDown"
                         PreviewMouseRightButtonDown="AccountList_PreviewMouseRightButtonDown"
                         MouseLeftButtonUp="AccountList_MouseLeftButtonUp">
                    <ListBox.Style>
                        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAccountListExpanded}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSidebarCompact}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                            <Setter Property="Padding"                   Value="16,9,18,9"/>
                            <Setter Property="ToolTip"                   Value="{Binding StatusLabel}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Visual only: the container carries the accessible name (AccessibleName). -->
                            <DockPanel>
                                <local:AriaHiddenTextBlock DockPanel.Dock="Right" Text="{Binding TotalUnread}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           FontSize="{DynamicResource Theme.FontSizeLarge}">
                                    <local:AriaHiddenTextBlock.Style>
                                        <Style TargetType="local:AriaHiddenTextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TotalUnread}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </local:AriaHiddenTextBlock.Style>
                                </local:AriaHiddenTextBlock>
                                <!-- Provider badge: MailBox MatriX's own coloured letter, not a logo. -->
                                <Border Width="22" Height="22" CornerRadius="3" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Theme.ProviderOther}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Converter={StaticResource AccountProviderConverter}}" Value="outlook">
                                                    <Setter Property="Background" Value="{DynamicResource Theme.ProviderOutlook}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Converter={StaticResource AccountProviderConverter}}" Value="gmail">
                                                    <Setter Property="Background" Value="{DynamicResource Theme.ProviderGmail}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Converter={StaticResource AccountProviderConverter}}" Value="hotmail">
                                                    <Setter Property="Background" Value="{DynamicResource Theme.ProviderHotmail}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <local:AriaHiddenTextBlock Text="{Binding AccountLabel, Converter={StaticResource InitialConverter}}"
                                                               Foreground="{DynamicResource Theme.ProviderGlyph}"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <local:AriaHiddenTextBlock Text="{Binding AccountLabel}" Margin="14,0,0,0"
                                                           FontSize="{DynamicResource Theme.FontSizeLarge}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ContextMenu>
                        <ContextMenu AutomationProperties.Name="Account actions">
                            <MenuItem Header="Re_connect"
                                      AutomationProperties.Name="Reconnect"
                                      Command="{Binding PlacementTarget.DataContext.ReconnectAccountCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="_Delete Account"
                                      AutomationProperties.Name="Delete Account"
                                      Command="{Binding PlacementTarget.DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Account _Settings…"
                                      AutomationProperties.Name="Account Settings"
                                      Command="{Binding PlacementTarget.DataContext.OpenAccountSettingsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <!-- Account order. The order is the array order in accounts.json, so
                                 moving here also moves the folder tree's account roots and the
                                 compose window's From list. Click handlers, not Command bindings:
                                 each move returns a sentence the window reports to the status bar
                                 and announces, and it re-focuses the moved row. Access keys C, D
                                 and S are taken above; U, W, R and N are free. -->
                            <MenuItem Header="Move _Up"
                                      AutomationProperties.Name="Move Up"
                                      InputGestureText="Alt+Up"
                                      Click="AccountContextMenu_MoveUp_Click"/>
                            <MenuItem Header="Move Do_wn"
                                      AutomationProperties.Name="Move Down"
                                      InputGestureText="Alt+Down"
                                      Click="AccountContextMenu_MoveDown_Click"/>
                            <MenuItem Header="Move to Sta_rt"
                                      AutomationProperties.Name="Move to Start"
                                      InputGestureText="Alt+Home"
                                      Click="AccountContextMenu_MoveToStart_Click"/>
                            <MenuItem Header="Move to E_nd"
                                      AutomationProperties.Name="Move to End"
                                      InputGestureText="Alt+End"
                                      Click="AccountContextMenu_MoveToEnd_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

            <!-- Folders header; the extra space above it separates the accounts from the folders. -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="14,28,14,4"
                        Visibility="{Binding IsSidebarCompact, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <local:AriaHiddenTextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="{DynamicResource Theme.FontSizeLarge}" VerticalAlignment="Center"/>
                <TextBlock Text="Folders" FontSize="{DynamicResource Theme.FontSizeLarge}"
                           Margin="14,0,0,0" VerticalAlignment="Center" Focusable="False"/>
            </StackPanel>

            <!-- Folders: the selected account's main folders (Windows Mail), or with "More" the full
                 QuickMail folder tree with every folder, the combined views, the calendar and saved
                 views. Activating a main folder opens it exactly as the tree does. -->
            <DockPanel Grid.Row="4"
                       Visibility="{Binding IsSidebarCompact, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                <ListBox x:Name="MainFolderList" DockPanel.Dock="Top"
                         AutomationProperties.Name="Main folders"
                         ItemsSource="{Binding MainFolders}"
                         TextSearch.TextPath="Label"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         KeyboardNavigation.TabNavigation="Once"
                         PreviewKeyDown="MainFolderList_PreviewKeyDown"
                         MouseLeftButtonUp="MainFolderList_MouseLeftButtonUp"
                         Visibility="{Binding ShowAllFolders, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="16,10,18,10"/>
                            <Setter Property="AutomationProperties.Name">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource MainFolderLabelConverter}">
                                        <Binding/>
                                        <Binding Path="ItemStatusLabel"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <!-- No folder menu here: its actions resolve their folder from a tree item.
                                 Folder actions are in the full tree ("More") and the Folder menu. -->
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Visual only: the container carries the name and the unread count. -->
                            <DockPanel>
                                <local:AriaHiddenTextBlock DockPanel.Dock="Right" Text="{Binding UnreadCountText}"
                                                           FontSize="{DynamicResource Theme.FontSizeLarge}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <local:AriaHiddenTextBlock Text="{Binding Converter={StaticResource FolderGlyphConverter}}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="{DynamicResource Theme.FontSizeLarge}"
                                                           VerticalAlignment="Center"/>
                                <local:AriaHiddenTextBlock Text="{Binding Converter={StaticResource MainFolderLabelConverter}}"
                                                           FontSize="{DynamicResource Theme.FontSizeLarge}"
                                                           Margin="14,0,0,0" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button x:Name="SidebarMoreFoldersButton" DockPanel.Dock="Top"
                        Command="{Binding ToggleAllFoldersCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Mbx.SidebarButton}">
                            <Setter Property="AutomationProperties.Name" Value="More folders"/>
                            <Setter Property="ToolTip" Value="Show every folder"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowAllFolders}" Value="True">
                                    <Setter Property="AutomationProperties.Name" Value="Main folders"/>
                                    <Setter Property="ToolTip" Value="Show the main folders only"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <local:AriaHiddenTextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{DynamicResource Theme.FontSizeLarge}" VerticalAlignment="Center"/>
                        <local:AriaHiddenTextBlock FontSize="{DynamicResource Theme.FontSizeLarge}"
                                                   Margin="14,0,0,0" VerticalAlignment="Center">
                            <local:AriaHiddenTextBlock.Style>
                                <Style TargetType="local:AriaHiddenTextBlock">
                                    <Setter Property="Text" Value="More"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowAllFolders}" Value="True">
                                            <Setter Property="Text" Value="Main folders"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:AriaHiddenTextBlock.Style>
                        </local:AriaHiddenTextBlock>
                    </StackPanel>
                </Button>

            <!-- True TreeView so screen readers announce level, expanded/collapsed state correctly. -->
                <TreeView x:Name="FolderList"
                          Background="Transparent"
                          Visibility="{Binding ShowAllFolders, Converter={StaticResource BoolToVisibilityConverter}}"
                          AutomationProperties.Name="Folder list"
                          ItemsSource="{Binding FolderTree}"
                          BorderThickness="0,0,1,0"
                          TabIndex="2"
                          KeyboardNavigation.TabNavigation="Once"
                          GotKeyboardFocus="FolderList_GotKeyboardFocus"
                          PreviewTextInput="FolderList_PreviewTextInput"
                          PreviewKeyDown="FolderList_PreviewKeyDown"
                          PreviewMouseLeftButtonDown="FolderList_PreviewMouseLeftButtonDown"
                          MouseLeftButtonUp="FolderList_MouseLeftButtonUp">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type models:FolderTreeNode}"
                                                  ItemsSource="{Binding Children}">
                            <!-- Visual display only. The TreeViewItem container carries the
                                 accessible name (AutomationProperties.Name → AutomationName)
                                 and unread count (AutomationProperties.ItemStatus →
                                 ItemStatusLabel). Splitting name and count across two UIA
                                 properties prevents JAWS from announcing the count twice
                                 (once per automation peer). -->
                            <StackPanel Orientation="Horizontal">
                                <local:AriaHiddenTextBlock Text="{Binding Converter={StaticResource FolderGlyphConverter}}"
                                                           FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"
                                                           Margin="0,0,10,0">
                                    <local:AriaHiddenTextBlock.Style>
                                        <Style TargetType="local:AriaHiddenTextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </local:AriaHiddenTextBlock.Style>
                                </local:AriaHiddenTextBlock>
                                <local:AriaHiddenTextBlock TextTrimming="CharacterEllipsis">
                                    <local:AriaHiddenTextBlock.Style>
                                        <Style TargetType="local:AriaHiddenTextBlock">
                                            <Setter Property="Text" Value="{Binding Label}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </local:AriaHiddenTextBlock.Style>
                                </local:AriaHiddenTextBlock>
                                <!-- Unread badge: "(5)" — collapsed when empty. Opacity, not
                                     Theme.TextSecondary, so it follows the selection foreground. -->
                                <local:AriaHiddenTextBlock Margin="4,0,0,0"
                                                           Opacity="0.75"
                                                           FontSize="{DynamicResource Theme.FontSizeSmall}"
                                                           Text="{Binding UnreadDisplay}">
                                    <local:AriaHiddenTextBlock.Style>
                                        <Style TargetType="local:AriaHiddenTextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UnreadDisplay}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </local:AriaHiddenTextBlock.Style>
                                </local:AriaHiddenTextBlock>
                                <!-- Default-calendar marker: "(default)" — collapsed when empty.
                                     Same treatment as the unread badge; the accessible name
                                     carries the same state via AutomationName. -->
                                <local:AriaHiddenTextBlock Margin="4,0,0,0"
                                                           Opacity="0.75"
                                                           FontSize="{DynamicResource Theme.FontSizeSmall}"
                                                           Text="{Binding DefaultCalendarDisplay}">
                                    <local:AriaHiddenTextBlock.Style>
                                        <Style TargetType="local:AriaHiddenTextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DefaultCalendarDisplay}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </local:AriaHiddenTextBlock.Style>
                                </local:AriaHiddenTextBlock>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded"                  Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Padding"                     Value="4,5"/>
                            <Setter Property="AutomationProperties.Name"   Value="{Binding AutomationName}"/>
                            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding ItemStatusLabel}"/>
                            <!-- Tag exposes the window DataContext (MainViewModel) to the ContextMenu -->
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="ContextMenu" Value="{StaticResource FolderContextMenu}"/>
                            <Style.Triggers>
                                <!-- Calendar nodes get calendar actions, not folder actions (#497). -->
                                <DataTrigger Binding="{Binding IsCalendarNode}" Value="True">
                                    <Setter Property="ContextMenu" Value="{StaticResource CalendarContextMenu}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </DockPanel>

            <!-- Profile, bottom left: picture, name and a menu (accounts, settings); the gear opens Settings. -->
            <Border Grid.Row="5" BorderBrush="{DynamicResource Theme.SidebarHover}" BorderThickness="0,1,0,0"
                    Padding="8,8">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Mbx.SidebarButton}"
                            Click="MenuSettings_Click"
                            AutomationProperties.Name="Settings"
                            ToolTip="Settings" Padding="10">
                        <local:AriaHiddenTextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{DynamicResource Theme.FontSizeLarge}"/>
                    </Button>
                    <Button x:Name="SidebarProfileButton"
                            Style="{StaticResource Mbx.SidebarButton}" Padding="6"
                            Click="SidebarProfileButton_Click"
                            AutomationProperties.Name="{Binding Accounts[0].SenderDisplayName, FallbackValue='Profile'}"
                            ToolTip="Accounts and settings"
                            Visibility="{Binding IsSidebarCompact, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Button.ContextMenu>
                            <ContextMenu AutomationProperties.Name="Profile">
                                <MenuItem Header="_Manage Accounts…"
                                          AutomationProperties.Name="Manage Accounts"
                                          Command="{Binding PlacementTarget.DataContext.ManageAccountsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="_Settings…"
                                          AutomationProperties.Name="Settings"
                                          Click="MenuSettings_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="36" Height="36" VerticalAlignment="Center">
                                <Ellipse Fill="{DynamicResource Theme.SidebarText}"/>
                                <local:AriaHiddenTextBlock
                                    Text="{Binding Accounts[0].SenderDisplayName, Converter={StaticResource InitialConverter}, FallbackValue=''}"
                                    Foreground="{DynamicResource Theme.SidebarBackground}"
                                    FontSize="{DynamicResource Theme.FontSizeLarge}" FontWeight="SemiBold"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <local:AriaHiddenTextBlock Text="{Binding Accounts[0].SenderDisplayName, FallbackValue=''}"
                                                       FontSize="{DynamicResource Theme.FontSizeLarge}"
                                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                            <local:AriaHiddenTextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                       Margin="10,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border/>
                </DockPanel>
            </Border>
        </Grid>


        <!-- ── Message list column ── -->
        <DockPanel Grid.Row="1" Grid.Column="1"
                   Background="{DynamicResource Theme.ListSurface}">

            <!-- List header: search, sync and view mode; then the placeholder tabs and sync range.
                 Fully opaque; everything below it is the ~90% list surface. -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Theme.SurfaceBackground}"
                    Padding="16,12,8,0">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button x:Name="ListHeaderSyncButton"
                                Style="{StaticResource Mbx.IconButton}"
                                Command="{Binding RefreshCommand}"
                                Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                AutomationProperties.Name="Sync"
                                AutomationProperties.AcceleratorKey="F5"
                                ToolTip="Sync (F5)"/>
            <Button x:Name="ViewModeButton"
                    Style="{StaticResource Mbx.IconButton}"
                    Content="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                    AutomationProperties.Name="View mode"
                    ToolTip="Select message view mode (Ctrl+Shift+V)"
                    Click="ViewModeButton_Click">
                <Button.ContextMenu>
                    <!-- Same collection the View menu binds, so the toolbar offers exactly the
                         modes that apply and announces the right count (#663). -->
                    <ContextMenu x:Name="ViewModeMenu"
                                 AutomationProperties.Name="View mode"
                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 ItemsSource="{Binding ViewModeOptions}"
                                 ItemContainerStyle="{StaticResource ViewModeMenuItemStyle}"/>
                </Button.ContextMenu>
            </Button>
                    </StackPanel>
                    <!-- Search: always visible. Focusing it starts a search, exactly as Ctrl+Shift+S
                         does; Escape clears it (SearchBox_PreviewKeyDown). -->
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource Mbx.SearchBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search mail"
                                 ToolTip="Search the messages in this folder. Escape to clear."
                                 GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                        <local:AriaHiddenTextBlock Text="Search mail" IsHitTestVisible="False"
                                                   Margin="11,0,36,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Theme.TextSecondary}">
                            <local:AriaHiddenTextBlock.Style>
                                <Style TargetType="local:AriaHiddenTextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:AriaHiddenTextBlock.Style>
                        </local:AriaHiddenTextBlock>
                        <local:AriaHiddenTextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                                   IsHitTestVisible="False"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Margin="0,0,11,0"
                                                   Foreground="{DynamicResource Theme.TextSecondary}"/>
                    </Grid>
                </DockPanel>

                <!-- Placeholder tabs where Windows 10 Mail had Focused / Other. Selectable and
                     keyboard-accessible (arrow keys within the group); they do not filter yet. -->
                <DockPanel Margin="0,10,0,0">
            <Button x:Name="SyncRangeButton" DockPanel.Dock="Right"
                    Style="{StaticResource Mbx.TextDropDownButton}"
                    Content="{Binding SyncRangeLabel}"
                    AutomationProperties.Name="Sync range"
                    ToolTip="Choose how many days of mail to sync"
                    Click="SyncRangeButton_Click">
                <Button.ContextMenu>
                    <ContextMenu AutomationProperties.Name="Sync range"
                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Last _7 Days"
                                  IsCheckable="True"
                                  IsChecked="{Binding IsSyncDays7, Mode=OneWay}"
                                  Command="{Binding SetSyncDaysCommand}"
                                  CommandParameter="7"/>
                        <MenuItem Header="Last _30 Days"
                                  IsCheckable="True"
                                  IsChecked="{Binding IsSyncDays30, Mode=OneWay}"
                                  Command="{Binding SetSyncDaysCommand}"
                                  CommandParameter="30"/>
                        <MenuItem Header="Last _6 Months (180 Days)"
                                  IsCheckable="True"
                                  IsChecked="{Binding IsSyncDays180, Mode=OneWay}"
                                  Command="{Binding SetSyncDaysCommand}"
                                  CommandParameter="180"/>
                        <MenuItem Header="Last _1 Year (365 Days)"
                                  IsCheckable="True"
                                  IsChecked="{Binding IsSyncDays365, Mode=OneWay}"
                                  Command="{Binding SetSyncDaysCommand}"
                                  CommandParameter="365"/>
                        <Separator/>
                        <MenuItem Header="_All Mail"
                                  IsCheckable="True"
                                  IsChecked="{Binding IsSyncDaysAll, Mode=OneWay}"
                                  Command="{Binding SetSyncDaysCommand}"
                                  CommandParameter="0"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
                    <StackPanel x:Name="PlaceholderTabs" Orientation="Horizontal"
                                AutomationProperties.Name="Message list tabs"
                                KeyboardNavigation.TabNavigation="Once"
                                KeyboardNavigation.DirectionalNavigation="Cycle">
                        <RadioButton Style="{StaticResource Mbx.PlaceholderTab}" GroupName="MbxPlaceholderTabs"
                                     Content="Tab 1" IsChecked="True"/>
                        <RadioButton Style="{StaticResource Mbx.PlaceholderTab}" GroupName="MbxPlaceholderTabs"
                                     Content="Tab 2"/>
                        <RadioButton Style="{StaticResource Mbx.PlaceholderTab}" GroupName="MbxPlaceholderTabs"
                                     Content="Tab 3"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
            </Border>
            <Border DockPanel.Dock="Top" Height="1" Margin="0,0,0,0" Background="{DynamicResource Theme.BorderSubtle}"/>


                    <!-- Contact-mail results bar (#370) — visible only while the message list is
                         showing "mail from / to a contact". Mirrors the search bar below: the
                         match count plus a Close that returns to the folder the search started
                         from, so the results are never a dead end. Escape does the same. -->
                    <Border DockPanel.Dock="Top"
                            Padding="6,4"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource Theme.Border}"
                            Visibility="{Binding IsContactMailView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel>
                            <!-- Click rather than a direct command binding: closing also moves
                                 focus to the message list and announces the result, both View
                                 concerns the VM must not reach into. -->
                            <Button DockPanel.Dock="Right"
                                    Content="Close"
                                    Click="CloseContactMailResults_Click"
                                    AutomationProperties.Name="Close search results"
                                    ToolTip="Close these results and go back (Escape)"
                                    IsTabStop="True"/>
                            <TextBlock VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       Focusable="False"
                                       Text="{Binding Messages.Count, StringFormat='{}{0} found'}"/>
                        </DockPanel>
                    </Border>

                    <!-- Search Results bar (#717) — visible only while the message list shows Advanced Search's
                         results across accounts. Like the contact-mail bar above: the query, the count, a way
                         back to Advanced Search to change it, and a Close that returns to where the search
                         started. Escape closes too. -->
                    <Border DockPanel.Dock="Top"
                            Padding="6,4"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource Theme.Border}"
                            Visibility="{Binding IsSearchResultsView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="Close"
                                    Click="CloseSearchResults_Click"
                                    AutomationProperties.Name="Close search results"
                                    ToolTip="Close these results and go back (Escape)"
                                    Margin="6,0,0,0"
                                    IsTabStop="True"/>
                            <Button DockPanel.Dock="Right"
                                    Content="Change Search"
                                    Click="ChangeSearch_Click"
                                    ToolTip="Open Advanced Search with this search (Ctrl+/)"
                                    Margin="6,0,0,0"
                                    IsTabStop="True"/>
                            <Button DockPanel.Dock="Right"
                                    Content="Search the Server"
                                    Click="SearchServer_Click"
                                    ToolTip="Ask the mail servers too, for mail not on this computer"
                                    IsTabStop="True"/>
                            <TextBlock VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       Focusable="False"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Messages.Count, Mode=OneWay, StringFormat='{}{0} found for'}"/>
                                <Run Text="{Binding SearchResultsQuery, Mode=OneWay}"/>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <!-- Search bar — visible only while IsSearchActive -->
                    <Border DockPanel.Dock="Top"
                            Padding="6,4"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource Theme.Border}"
                            Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="Clear"
                                    Command="{Binding ClearSearchCommand}"
                                    AutomationProperties.Name="Clear search"
                                    ToolTip="Clear search (Escape)"
                                    IsTabStop="True"/>
                            <TextBlock DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       Margin="6,0"
                                       Focusable="False"
                                       Text="{Binding Messages.Count, StringFormat='{}{0} found'}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top"
                               Text="No messages"
                               HorizontalAlignment="Center" Margin="0,20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Standard list view and conversation tree occupy the same space;
                         only one is visible at a time based on ViewMode. -->
                    <Grid>
                    <!-- Calendar (master/detail) — shown in place of the message list when the
                         Calendar virtual folder is selected. A columned event list (Subject /
                         When / Status) on top, a read-only Details pane below. Up/Down to browse,
                         Enter to open (edit an appointment, or the source invite), N new, E edit,
                         Delete to remove, T today, F5 refresh, Escape to return to the folder tree. -->
                    <Grid Visibility="{Binding IsCalendarView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <!-- View switch + period navigation. Arrows stay within the group. -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,4,6,0"
                                    KeyboardNavigation.TabNavigation="Continue"
                                    KeyboardNavigation.DirectionalNavigation="Contained">
                            <Button Content="_Agenda" AutomationProperties.Name="Agenda view"
                                    MinWidth="64" Margin="0,0,4,0" Click="CalendarAgenda_Click"/>
                            <Button Content="_Day" AutomationProperties.Name="Day view"
                                    MinWidth="52" Margin="0,0,4,0" Click="CalendarDay_Click"/>
                            <Button Content="_Week" AutomationProperties.Name="Week view"
                                    MinWidth="56" Margin="0,0,4,0" Click="CalendarWeek_Click"/>
                            <Button Content="_Month" AutomationProperties.Name="Month view"
                                    MinWidth="56" Margin="0,0,12,0" Click="CalendarMonth_Click"/>
                            <Button Content="◀" AutomationProperties.Name="Previous period"
                                    MinWidth="32" Margin="0,0,4,0" Click="CalendarPrev_Click"/>
                            <Button Content="Today" AutomationProperties.Name="Go to today"
                                    MinWidth="56" Margin="0,0,4,0" Click="CalendarToday_Click"/>
                            <Button Content="▶" AutomationProperties.Name="Next period"
                                    MinWidth="32" Margin="0,0,12,0" Click="CalendarNext_Click"/>
                            <Button Content="_Go To Date…" AutomationProperties.Name="Go to date"
                                    MinWidth="96" Click="CalendarGoToDate_Click"/>
                        </StackPanel>

                        <!-- Period label + search + item toolbar -->
                        <DockPanel Grid.Row="1" Margin="6,4" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding CalendarVm.PeriodLabel}"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBox x:Name="CalendarSearchBox"
                                     DockPanel.Dock="Left"
                                     AutomationProperties.Name="Search appointments"
                                     Text="{Binding CalendarVm.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding CalendarVm.IsSearchActive, Converter={StaticResource BoolToVisibilityConverter}}"
                                     MinWidth="160" Margin="12,0,0,0" VerticalAlignment="Center"
                                     PreviewKeyDown="CalendarSearchBox_PreviewKeyDown"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        KeyboardNavigation.TabNavigation="Continue"
                                        KeyboardNavigation.DirectionalNavigation="Contained">
                                <Button Content="_New" AutomationProperties.Name="New appointment"
                                        MinWidth="64" Margin="0,0,6,0" Click="CalendarNew_Click"/>
                                <Button Content="_Edit" AutomationProperties.Name="Edit appointment"
                                        MinWidth="64" Margin="0,0,6,0" Click="CalendarEdit_Click"/>
                                <Button Content="De_lete" AutomationProperties.Name="Delete appointment"
                                        MinWidth="64" Click="CalendarDelete_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Month grid — a 7-column day grid shown instead of the event list in
                             Month view. Arrows move spatially (left/right = day, up/down = week);
                             Enter drills into that day. Each cell speaks "Tuesday June 9, 3 events". -->
                        <ListBox x:Name="MonthGrid"
                                 Grid.Row="2"
                                 AutomationProperties.Name="Month grid"
                                 Visibility="{Binding CalendarVm.IsMonthView, Converter={StaticResource BoolToVisibilityConverter}}"
                                 ItemsSource="{Binding CalendarVm.MonthCells}"
                                 SelectedItem="{Binding CalendarVm.SelectedMonthCell, Mode=TwoWay}"
                                 BorderThickness="0"
                                 KeyboardNavigation.TabNavigation="Once"
                                 KeyboardNavigation.DirectionalNavigation="Contained"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CellText}" Padding="6,8" TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInMonth}" Value="False">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListView x:Name="CalendarList"
                                  Grid.Row="2"
                                  AutomationProperties.Name="Calendar events"
                                  Visibility="{Binding CalendarVm.IsListView, Converter={StaticResource BoolToVisibilityConverter}}"
                                  ItemsSource="{Binding CalendarVm.Events}"
                                  SelectedItem="{Binding CalendarVm.SelectedEvent, Mode=TwoWay}"
                                  BorderThickness="0"
                                  TabIndex="3"
                                  KeyboardNavigation.TabNavigation="Once"
                                  KeyboardNavigation.DirectionalNavigation="Contained"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  GotKeyboardFocus="CalendarList_GotKeyboardFocus"
                                  PreviewKeyDown="CalendarList_PreviewKeyDown">
                            <ListView.ItemContainerStyle>
                                <!-- BasedOn the GRIDVIEW container style, not the plain ListViewItem
                                     style: the plain one's template hosts a ContentPresenter, so rows
                                     rendered item.ToString() ("QuickMail.Models.CalendarEvent") and the
                                     columns never appeared (#448). Invisible to a screen reader — the
                                     row name below was always correct — which is why it took the visual
                                     harness to catch it. -->
                                <Style TargetType="ListViewItem"
                                       BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                                    <!-- Row name = the stamped accessible name (data-only or field-labeled
                                         per the CalendarListShowFieldLabels setting); the visual columns
                                         aid sighted users. -->
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Subject" Width="260"
                                                    DisplayMemberBinding="{Binding Summary}"/>
                                    <GridViewColumn Header="When" Width="170"
                                                    DisplayMemberBinding="{Binding WhenText}"/>
                                    <GridViewColumn Header="Status" Width="110"
                                                    DisplayMemberBinding="{Binding StatusText}"/>
                                    <GridViewColumn Header="Calendar" Width="150"
                                                    DisplayMemberBinding="{Binding CalendarSourceLabel}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch"
                                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                                      IsTabStop="False"
                                      Background="{DynamicResource Theme.Border}"/>

                        <TextBox x:Name="CalendarDetails"
                                 Grid.Row="4"
                                 AutomationProperties.Name="Appointment details"
                                 Text="{Binding CalendarVm.SelectedEventDetail, Mode=OneWay}"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True"
                                 TextChanged="CalendarDetails_TextChanged"
                                 TabIndex="4"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Margin="4"/>
                    </Grid>

                    <ListView x:Name="MessageList"
                              AutomationProperties.Name="Messages"
                              ContextMenu="{StaticResource MessageContextMenu}"
                              ItemsSource="{Binding Messages}"
                              SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                              SelectionMode="Extended"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              TabIndex="3"
                              KeyboardNavigation.TabNavigation="Once"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              GotKeyboardFocus="List_GotKeyboardFocus"
                              PreviewTextInput="MessageList_PreviewTextInput"
                              PreviewKeyDown="MessageList_PreviewKeyDown"
                              PreviewMouseLeftButtonDown="MessageList_PreviewMouseLeftButtonDown"
                              MouseLeftButtonUp="MessageList_MouseLeftButtonUp">
                        <ListView.Style>
                            <Style TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
                                <Setter Property="Visibility" Value="{Binding IsMessagesView, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCalendarView}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.Style>
                        <!-- MailBox MatriX: no columns; each row is the stacked layout in the container template below. -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <!-- Flag colour strip: takes space only on a flagged message, so the
                                     selection marker sits flush at the left edge otherwise and just
                                     inside the flag colour when there is one. -->
                                <Setter Property="BorderThickness" Value="4,0,0,0"/>
                                <Setter Property="BorderBrush">
                                    <Setter.Value>
                                        <Binding Path="FlagColorHex" Converter="{StaticResource StringToBrushConverter}"/>
                                    </Setter.Value>
                                </Setter>
                                <!-- Spoken name. Which fields are said and in what order comes from
                                     the user's layout (Message List Fields window), not from this
                                     template: RowSpeech installs the binding from RowFieldCatalog. -->
                                <Setter Property="local:RowSpeech.Kind" Value="{x:Static models:RowKind.Message}"/>
                                <!-- Token-driven row template. The default GridView container paints
                                     selection with hardcoded light colors that are unreadable on a
                                     dark theme; under High Contrast the token brushes resolve to the
                                     live SystemColors palette, so this stays HC-correct. The outer
                                     Border keeps the flag color bar (BorderBrush/Thickness above);
                                     the 3px inner bar is the additive unread cue — SemiBold text
                                     remains the primary cue. -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <!-- MailBox MatriX row. Layers, back to front: read/unread tint; the
                                                 contextual image (right-anchored, faded in from the text side by
                                                 the opacity mask, drawn as a brush so the text decides the row
                                                 height); hover/selection wash with the selected-row marker; the
                                                 content. The outer border keeps QuickMail's flag-colour bar.
                                                 Unread is never colour alone: bold text and a closed envelope. -->
                                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    SnapsToDevicePixels="True">
                                                <Grid x:Name="rowRoot" MinHeight="76" ClipToBounds="True">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40*"/>
                                                        <ColumnDefinition Width="60*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="tint" Grid.ColumnSpan="2"
                                                            Background="{DynamicResource Theme.RowReadBackground}"
                                                            BorderBrush="{DynamicResource Theme.BorderSubtle}"
                                                            BorderThickness="0,0,0,1"/>
                                                    <Border x:Name="rowImage" Grid.Column="1" Margin="0,0,0,1"
                                                            Background="{Binding Converter={StaticResource ContextImageBrushConverter}}"
                                                            Opacity="{DynamicResource Theme.ImageryOpacity}">
                                                        <Border.OpacityMask>
                                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                                <GradientStop Color="#00000000" Offset="0"/>
                                                                <GradientStop Color="#B0000000" Offset="0.3"/>
                                                                <GradientStop Color="#FF000000" Offset="0.55"/>
                                                            </LinearGradientBrush>
                                                        </Border.OpacityMask>
                                                    </Border>
                                                    <Border x:Name="wash" Grid.ColumnSpan="2" Background="Transparent"
                                                            BorderBrush="Transparent" BorderThickness="3,0,0,0"/>
                                                    <Grid Grid.ColumnSpan="2" Margin="14,9,14,9">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Width="40" Height="40" VerticalAlignment="Top" Margin="0,2,14,0">
                                                            <!-- One of six colours per sender, so senders are told apart at a glance. -->
                                                            <Ellipse>
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="{DynamicResource Theme.AvatarBackground}"/>
                                                                        <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding From, Converter={StaticResource AvatarColorIndexConverter}}" Value="1">
                                                                            <Setter Property="Fill" Value="{DynamicResource Theme.AvatarAlt1}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding From, Converter={StaticResource AvatarColorIndexConverter}}" Value="2">
                                                                            <Setter Property="Fill" Value="{DynamicResource Theme.AvatarAlt2}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding From, Converter={StaticResource AvatarColorIndexConverter}}" Value="3">
                                                                            <Setter Property="Fill" Value="{DynamicResource Theme.AvatarAlt3}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding From, Converter={StaticResource AvatarColorIndexConverter}}" Value="4">
                                                                            <Setter Property="Fill" Value="{DynamicResource Theme.AvatarAlt4}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding From, Converter={StaticResource AvatarColorIndexConverter}}" Value="5">
                                                                            <Setter Property="Fill" Value="{DynamicResource Theme.AvatarAlt5}"/>
                                                                        </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <local:AriaHiddenTextBlock
                                                                Text="{Binding From, Converter={StaticResource InitialConverter}}"
                                                                Foreground="{DynamicResource Theme.AvatarText}"
                                                                FontSize="{DynamicResource Theme.FontSizeLarge}" FontWeight="SemiBold"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding From}" FontSize="{DynamicResource Theme.FontSizeLarge}"
                                                                       Foreground="{DynamicResource Theme.TextPrimary}"
                                                                       FontWeight="{Binding IsRead, Converter={StaticResource BoolToWeightConverter}}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <!-- Only the sender is bold on unread mail (Windows Mail); the
                                                                 closed envelope and the tint are the other unread cues. -->
                                                            <TextBlock Text="{Binding Subject}"
                                                                       Foreground="{DynamicResource Theme.TextPrimary}"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Subject}"/>
                                                            <TextBlock Text="{Binding Preview}"
                                                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Grid Grid.Column="2" Margin="12,0,0,0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <local:AriaHiddenTextBlock x:Name="attachmentMark" Text="&#xE723;"
                                                                                           FontFamily="Segoe MDL2 Assets"
                                                                                           Foreground="{DynamicResource Theme.TextPrimary}"
                                                                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                                                                           Visibility="Collapsed"/>
                                                                <!-- Visual only; RowSpeech still speaks DateDisplay. -->
                                                                <TextBlock Text="{Binding FriendlyDate}"
                                                                           Foreground="{DynamicResource Theme.TextPrimary}"/>
                                                            </StackPanel>
                                                            <!-- The envelope is also a button: clicking it toggles read /
                                                                 unread without opening the message (Windows Mail). Mouse
                                                                 affordance only: Ctrl+Q / Ctrl+U and the context menu are the
                                                                 keyboard paths, so it is not a tab stop inside the row. -->
                                                            <Button x:Name="envButton" Grid.Row="1"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                    Margin="0,4,0,0" Padding="6,4,0,0"
                                                                    Focusable="False" IsTabStop="False" Cursor="Hand"
                                                                    Tag="{Binding}" Click="RowEnvelope_Click"
                                                                    AutomationProperties.Name="Mark as unread"
                                                                    ToolTip="Mark as unread">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <Grid>
                                                                    <!-- Unread: closed, filled envelope. -->
                                                                    <Canvas x:Name="envClosed" Width="24" Height="18"
                                                                            VerticalAlignment="Bottom" Visibility="Collapsed">
                                                                        <Rectangle Width="24" Height="18" Fill="{DynamicResource Theme.EnvelopeUnread}"/>
                                                                        <Path Data="M1.5,1.5 L12,10 L22.5,1.5"
                                                                              Stroke="{DynamicResource Theme.EnvelopeUnreadGlyph}" StrokeThickness="1.6"/>
                                                                    </Canvas>
                                                                    <!-- Read: open envelope, outline only, transparent fill. -->
                                                                    <Path x:Name="envOpen" Width="24" Height="22"
                                                                          VerticalAlignment="Bottom"
                                                                          Stretch="Uniform" StrokeThickness="1.4" Fill="Transparent"
                                                                          Stroke="{DynamicResource Theme.EnvelopeRead}"
                                                                          Data="M1,9 L12,1 L23,9 L23,23 L1,23 Z M1,9 L12,16 L23,9 M1,23 L9,15 M23,23 L15,15"/>
                                                                </Grid>
                                                            </Button>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                    <Setter TargetName="tint" Property="Background" Value="{DynamicResource Theme.RowUnreadBackground}"/>
                                                    <Setter TargetName="envClosed" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="envOpen" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="envButton" Property="AutomationProperties.Name" Value="Mark as read"/>
                                                    <Setter TargetName="envButton" Property="ToolTip" Value="Mark as read"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasAttachments}" Value="True">
                                                    <Setter TargetName="attachmentMark" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="wash" Property="Background" Value="{DynamicResource Theme.RowHoverWash}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="wash" Property="Background" Value="{DynamicResource Theme.RowSelectedWash}"/>
                                                    <Setter TargetName="wash" Property="BorderBrush" Value="{DynamicResource Theme.RowSelectedMarker}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFlagged}" Value="False">
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <!-- Conversation tree view: one root node per subject group, children are individual messages. -->
                    <TreeView x:Name="ConversationTree"
                              AutomationProperties.Name="Messages"
                              ItemsSource="{Binding Conversations}"
                              BorderThickness="0"
                              TabIndex="3"
                              KeyboardNavigation.TabNavigation="Once"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              GotKeyboardFocus="ConversationTree_GotKeyboardFocus"
                              SelectedItemChanged="ConversationTree_SelectedItemChanged"
                              PreviewTextInput="ConversationTree_PreviewTextInput"
                              PreviewKeyDown="ConversationTree_PreviewKeyDown"
                              PreviewMouseRightButtonDown="ConversationTree_PreviewMouseRightButtonDown"
                              ContextMenuOpening="ConversationTree_ContextMenuOpening"
                              PreviewMouseLeftButtonDown="GroupTree_PreviewMouseLeftButtonDown"
                              MouseLeftButtonUp="GroupTree_MouseLeftButtonUp">
                        <TreeView.Style>
                            <Style TargetType="TreeView" BasedOn="{StaticResource {x:Type TreeView}}">
                                <Setter Property="Visibility" Value="{Binding IsConversationsView, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCalendarView}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.Style>
                        <TreeView.Resources>
                            <!-- Style for level-2 message rows (children of a conversation node) -->
                            <Style x:Key="MessageTreeItemStyle" TargetType="TreeViewItem"
