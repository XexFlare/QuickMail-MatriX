                        </TreeView.Style>
                        <TreeView.Resources>
                            <!-- Style for level-2 message rows (children of a recipient group node) -->
                            <Style x:Key="ToMessageTreeItemStyle" TargetType="TreeViewItem"
                                   BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <!-- Spoken name. Which fields are said and in what order comes from
                                     the user's layout (Message List Fields window), not from this
                                     template: RowSpeech installs the binding from RowFieldCatalog. -->
                                <Setter Property="local:RowSpeech.Kind" Value="{x:Static models:RowKind.Message}"/>
                            </Style>

                            <!-- Level 1: recipient group header with address + count + newest subject -->
                            <HierarchicalDataTemplate DataType="{x:Type models:SenderGroup}"
                                                      ItemsSource="{Binding Messages}"
                                                      ItemContainerStyle="{StaticResource ToMessageTreeItemStyle}">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Left" Width="16">
                                        <Border Width="4" HorizontalAlignment="Left" IsHitTestVisible="False"
                                                Background="{Binding FlagColorHex, Converter={StaticResource StringToBrushConverter}}"/>
                                        <Border Background="Transparent"
                                                Focusable="False"
                                                Tag="{Binding}"
                                                MouseLeftButtonUp="FlagHitArea_MouseLeftButtonUp"/>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock TextTrimming="CharacterEllipsis"
                                                   FontWeight="{Binding HasUnread, Converter={StaticResource BoolToWeightConverter}}">
                                            <Run Text="{Binding SenderName, Mode=OneWay}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Count, StringFormat=({0}), Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding NewestSubject}"
                                                   FontSize="{DynamicResource Theme.FontSizeSmall}" Opacity="0.85"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NewestSubject}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Preview}"
                                                   FontSize="{DynamicResource Theme.FontSizeSmall}" Opacity="0.75"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Preview}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </HierarchicalDataTemplate>

                            <!-- Level 2: individual message row matching the ListView column layout -->
                            <DataTemplate DataType="{x:Type models:MailMessageSummary}">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Left" Width="16">
                                        <Border Width="4" HorizontalAlignment="Left" IsHitTestVisible="False"
                                                Background="{Binding FlagColorHex, Converter={StaticResource StringToBrushConverter}}"/>
                                        <Border Background="Transparent"
                                                Focusable="False"
                                                Tag="{Binding}"
                                                MouseLeftButtonUp="FlagHitArea_MouseLeftButtonUp"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding From}"
                                                   FontWeight="{Binding IsRead, Converter={StaticResource BoolToWeightConverter}}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Subject}"
                                                   FontWeight="{Binding IsRead, Converter={StaticResource BoolToWeightConverter}}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DateDisplay}"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                </DockPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <!-- Style for root-level recipient group nodes: starts collapsed.
                                 Recipient groups reuse SenderGroup rows and therefore its layout. -->
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="local:RowSpeech.Kind" Value="{x:Static models:RowKind.SenderGroup}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>

                    </Grid>
                </DockPanel>


        <!-- Invisible (the list edge against the picture is the divider) but still draggable;
             the resize cursor shows where it is. -->
        <GridSplitter Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Width="4" HorizontalAlignment="Stretch"
                      Background="Transparent"
                      IsTabStop="False"
                      AutomationProperties.Name="Resize message list and reading area"/>

        <!-- ── Scenic main area ──
             Transparent: the window-wide picture (MbxBackdrop) shows here unobstructed. An opened
             message sits on the translucent reading surface over it, with the message command bar
             and any open message tabs above. Caption buttons float at the top right. -->
        <Grid x:Name="MainArea" Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>    <!-- caption / drag strip -->
                <RowDefinition Height="Auto"/>  <!-- message command bar -->
                <RowDefinition Height="Auto"/>  <!-- open message tabs -->
                <RowDefinition Height="*"/>     <!-- reading surface -->
            </Grid.RowDefinitions>

            <!-- The reading surface: an open message fills the whole right pane, edge to edge and
                 from the top (as Windows 10 Mail did), with the caption buttons over it. -->
            <Border x:Name="ReadingSurfaceBackdrop" Grid.RowSpan="4" IsHitTestVisible="False"
                    Background="{DynamicResource Theme.ReadingSurface}"
                    Visibility="{Binding IsMessageOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Caption strip: drag to move, double-click to maximize. -->
            <Border x:Name="CaptionDragArea" Grid.Row="0" Background="Transparent"
                    MouseLeftButtonDown="CaptionDragArea_MouseLeftButtonDown"/>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Panel.ZIndex="30">
                <Button x:Name="CaptionMinimizeButton" Style="{StaticResource Mbx.CaptionButton}"
                        Content="&#xE921;" Click="CaptionMinimize_Click"
                        AutomationProperties.Name="Minimize" ToolTip="Minimize"/>
                <Button x:Name="CaptionMaximizeButton" Style="{StaticResource Mbx.CaptionButton}"
                        Content="&#xE922;" Click="CaptionMaximize_Click"
                        AutomationProperties.Name="Maximize" ToolTip="Maximize"/>
                <Button x:Name="CaptionCloseButton" Style="{StaticResource Mbx.CaptionCloseButton}"
                        Content="&#xE8BB;" Click="CaptionClose_Click"
                        AutomationProperties.Name="Close" ToolTip="Close (Alt+F4)"/>
            </StackPanel>

            <!-- Message command bar (QuickMail's toolbar, trimmed to message actions). -->
            <Border Grid.Row="1" Margin="16,0,16,0"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Theme.BorderSubtle}"
                    Visibility="{Binding IsMessageOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- Close sits outside the toolbar so it never falls into the toolbar's overflow. -->
            <DockPanel>
            <Button x:Name="ToolbarCloseMessageButton" DockPanel.Dock="Right"
                    Style="{StaticResource Mbx.IconButton}"
                    Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                    Click="ToolbarCloseMessage_Click"
                    AutomationProperties.Name="Close message"
                    AutomationProperties.AcceleratorKey="Escape"
                    ToolTip="Close message (Esc)"/>
        <ToolBar x:Name="MainToolbar"
                 Background="Transparent" BorderThickness="0" Padding="8,4"
                 
                 AutomationProperties.Name="Main toolbar"
                 KeyboardNavigation.TabNavigation="None"
                 KeyboardNavigation.DirectionalNavigation="Cycle"
                 PreviewKeyDown="Toolbar_PreviewKeyDown">
            <Button x:Name="ToolbarFirstButton"
                    Style="{DynamicResource ToolbarButton}"
                    Command="{Binding ReplyCommand}"
                    AutomationProperties.Name="Reply"
                    AutomationProperties.AcceleratorKey="Ctrl+R"
                    ToolTip="Reply (Ctrl+R)"
                    Content="Reply"/>
            <Button Style="{DynamicResource ToolbarButton}"
                    Command="{Binding ReplyAllCommand}"
                    AutomationProperties.Name="Reply All"
                    AutomationProperties.AcceleratorKey="Ctrl+Shift+R"
                    ToolTip="Reply All (Ctrl+Shift+R)"
                    Content="Reply All"/>
            <Button Style="{DynamicResource ToolbarButton}"
                    Command="{Binding ForwardCommand}"
                    AutomationProperties.Name="Forward"
                    AutomationProperties.AcceleratorKey="Ctrl+Shift+F"
                    ToolTip="Forward (Ctrl+Shift+F)"
                    Content="Forward"/>
            <Separator/>
            <Button Style="{DynamicResource ToolbarButton}"
                    Command="{Binding ArchiveMessageCommand}"
                    AutomationProperties.Name="Archive"
                    AutomationProperties.AcceleratorKey="Ctrl+Shift+M"
                    ToolTip="Archive (Ctrl+Shift+M)"
                    Content="Archive"/>
            <Button Style="{DynamicResource ToolbarButton}"
                    Command="{Binding DeleteMessageCommand}"
                    AutomationProperties.Name="Delete message"
                    AutomationProperties.AcceleratorKey="Delete"
                    ToolTip="Delete (Del)"
                    Content="Delete"/>
            <Button x:Name="ToolbarMarkUnreadButton"
                    Style="{DynamicResource ToolbarButton}"
                    Click="ToolbarMarkUnread_Click"
                    AutomationProperties.Name="Mark as Unread"
                    AutomationProperties.AcceleratorKey="Ctrl+U"
                    ToolTip="Mark as unread (Ctrl+U)"
                    Content="Mark Unread"/>
        </ToolBar>
            </DockPanel>
            </Border>

                <Border Grid.Row="2"
                        x:Name="TabStripBorder"
                        Margin="16,0,16,0"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource Theme.BorderSubtle}"
                        Visibility="{Binding ShowTabStrip, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox x:Name="TabStrip"
                             ItemsSource="{Binding OpenTabs}"
                             SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                             SelectionMode="Single"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             KeyboardNavigation.TabNavigation="Once"
                             AutomationProperties.Name="Open message tabs"
                             SelectionChanged="TabStrip_SelectionChanged"
                             PreviewKeyDown="TabStrip_PreviewKeyDown"
                             PreviewMouseDown="TabStrip_PreviewMouseDown"
                             GotKeyboardFocus="TabStrip_GotKeyboardFocus"
                             LostKeyboardFocus="TabStrip_LostKeyboardFocus">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="Margin" Value="0,0,1,0"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                                <Setter Property="ToolTip" Value="{Binding Title}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}"
                                               MaxWidth="160"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <Button Content="✕"
                                            Width="16" Height="16"
                                            Padding="0"
                                            Margin="6,0,0,0"
                                            FontSize="9"
                                            Click="TabCloseButton_Click"
                                            Tag="{Binding}"
                                            IsTabStop="False"
                                            AutomationProperties.Name="Close this tab"
                                            ToolTip="Close tab"
                                            Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

            <!-- Body pane — hidden until IsMessageOpen; Escape returns to MessageList. Sits on the
                 ~90% opaque reading surface (ReadingSurfaceBackdrop); the HTML body itself is opaque
                 (WebView2 is a native window and cannot blend with WPF content) and fills the pane. -->
                <Border Grid.Row="3" x:Name="ReadingSurface"
                        MinHeight="200"
                        Visibility="{Binding IsMessageOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="32,14,32,0">
                            <TextBox x:Name="SubjectField"
                                     Text="{Binding MessageDetail.Subject, FallbackValue='', Mode=OneWay}"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="{DynamicResource Theme.FontSizeHeader}" FontWeight="SemiBold" TextWrapping="Wrap"
                                     AutomationProperties.Name="Subject"/>
                            <TextBox x:Name="FromField"
                                     Text="{Binding MessageDetail.From, FallbackValue='', Mode=OneWay}"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                     BorderThickness="0" Background="Transparent"
                                     Margin="0,8,0,0"
                                     FontSize="{DynamicResource Theme.FontSizeLarge}"
                                     AutomationProperties.Name="From"/>
                            <TextBox x:Name="ToField"
                                     Text="{Binding MessageDetail.To, FallbackValue='', Mode=OneWay}"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource Theme.TextSecondary}"
                                     AutomationProperties.Name="To"/>
                            <TextBox x:Name="CcField"
                                     Text="{Binding MessageDetail.Cc, FallbackValue='', Mode=OneWay}"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource Theme.TextSecondary}"
                                     AutomationProperties.Name="Cc">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MessageDetail.Cc}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MessageDetail.Cc}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBox x:Name="DateField"
                                     Text="{Binding MessageDetail.Date, StringFormat='{}{0:f}', FallbackValue='', Mode=OneWay}"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource Theme.TextSecondary}"
                                     AutomationProperties.Name="Date"/>

                            <!-- Attachments (visible when selected message has attachments) -->
                            <ListBox x:Name="ReadingPaneAttachmentList"
                                     ItemsSource="{Binding MessageDetail.Attachments}"
                                     SelectionMode="Single"
                                     BorderThickness="0"
                                     Margin="0,4,0,0"
                                     Visibility="{Binding SelectedMessage.HasAttachments,
                                                  Converter={StaticResource BoolToVisibilityConverter},
                                                  FallbackValue=Collapsed}"
                                     KeyboardNavigation.TabNavigation="Once"
                                     KeyboardNavigation.DirectionalNavigation="Contained"
                                     AutomationProperties.Name="Attachments"
                                     PreviewKeyDown="ReadingPaneAttachmentList_PreviewKeyDown"
                                     GotKeyboardFocus="ReadingPaneAttachmentList_GotKeyboardFocus"
                                     MouseDoubleClick="ReadingPaneAttachmentList_MouseDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileName}" ToolTip="{Binding FileSizeDisplay}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="_Save…"
                                                  Command="{Binding PlacementTarget.DataContext.SaveAttachmentCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Save _All…"
                                                  Command="{Binding PlacementTarget.DataContext.SaveAllAttachmentsCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="_Open"
                                                  Command="{Binding PlacementTarget.DataContext.OpenAttachmentCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>

                            <Border Height="1" Margin="0,10,0,0" Background="{DynamicResource Theme.BorderSubtle}"/>
                        </StackPanel>
                        <!-- WebView2: real browser, proper arrow-key caret nav, screen-reader virtual cursor -->
                        <wv2:WebView2 x:Name="MessageBody"
                                      AutomationProperties.Name="Message body"
                                      KeyboardNavigation.IsTabStop="True"
                                      GotKeyboardFocus="MessageBody_GotKeyboardFocus"
                                      MinHeight="80"/>
                    </DockPanel>
                </Border>
        </Grid>


        <!-- ── Status bar ── -->
        <!-- Each StatusBarItem is a distinct focus stop within the status bar.
             Left/Right arrows navigate between regions; Tab exits to the next F6 pane.
             Informational regions use read-only TextBox (ControlType.Edit + ValuePattern).
             Clickable regions use Button (ControlType.Button + InvokePattern).
             The StatusBar UIA control pattern enables screen readers' built-in
             status-bar read commands. -->
        <StatusBar x:Name="MainStatusBar"
                   Grid.Row="2" Grid.Column="1"
                   KeyboardNavigation.TabNavigation="None"
                   KeyboardNavigation.DirectionalNavigation="Contained"
                   AutomationProperties.Name="">

            <!-- Region 1: Status message + Last sync time (single TextBlock for unified screen reader reading).
                 E.g., "7323 messages. Synced 9:29 AM" or "Connecting and syncing... Never synced" -->
            <StatusBarItem x:Name="StatusTextItem"
                           KeyboardNavigation.IsTabStop="False">
                <TextBlock x:Name="StatusTextBox"
                           Style="{StaticResource StatusTextBlockStyle}">
                    <Run Text="{Binding StatusText, Mode=OneWay}"/>
                    <Run Text="{Binding LastSyncText, StringFormat=' {0}', Mode=OneWay}"/>
                </TextBlock>
            </StatusBarItem>

            <!-- Region 2: Connection state (informational) -->
            <StatusBarItem x:Name="ConnectionStatusItem"
                           KeyboardNavigation.IsTabStop="False">
                <TextBlock x:Name="ConnectionStatusTextBox"
                           Style="{StaticResource StatusTextBlockStyle}"
                           Text="{Binding ConnectionStatusText, Mode=OneWay}"/>
            </StatusBarItem>

            <!-- Spacer: pushes Rules and Progress to the right -->
            <Separator Style="{StaticResource StatusBarSpacerStyle}"/>

            <!-- Region 3: Update notification (hidden until a newer release is detected).
                 Visibility tracks UpdateReleaseUrl (set only when an update exists) rather than the
                 menu label, which is now always populated ("No updates available" at rest). -->
            <StatusBarItem x:Name="UpdateStatusItem"
                           HorizontalAlignment="Right"
                           KeyboardNavigation.IsTabStop="True"
                           Visibility="{Binding UpdateReleaseUrl, Converter={StaticResource StringToVisibilityConverter}}">
                <Button x:Name="UpdateStatusButton"
                        Style="{StaticResource StatusBarButtonStyle}"
                        Content="{Binding UpdateAvailableText, Mode=OneWay}"
                        Command="{Binding OpenUpdatePageCommand}"
                        ToolTip="Press Enter to open the release page in your browser"/>
            </StatusBarItem>

            <!-- Region 3 (focus order): Rules status (clickable — opens Rules Manager) -->
            <StatusBarItem x:Name="RulesStatusItem"
                           HorizontalAlignment="Right"
                           KeyboardNavigation.IsTabStop="True">
                <Button x:Name="RulesStatusButton"
                        Style="{StaticResource StatusBarButtonStyle}"
                        Content="{Binding RulesStatusText, Mode=OneWay}"
                        Click="RulesStatusButton_Click"
                        AutomationProperties.Name="{Binding RulesStatusText, Mode=OneWay}"
                        ToolTip="Open Rules Manager (Ctrl+Shift+L)"/>
            </StatusBarItem>

            <!-- Region 4 (focus order): Offline reading (#717) — how many messages have their full text, and whether more
                 are coming down. Hidden when the setting is off, so it never says nothing at length. -->
            <StatusBarItem x:Name="OfflineStatusItem"
                           HorizontalAlignment="Right"
                           KeyboardNavigation.IsTabStop="True"
                           Visibility="{Binding OfflineBodyStatusText, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock x:Name="OfflineStatusTextBox"
                           Style="{StaticResource StatusTextBlockStyle}"
                           Text="{Binding OfflineBodyStatusText, Mode=OneWay}"/>
            </StatusBarItem>

            <!-- Region 5: Sync progress (informational, visible only when busy) -->
            <StatusBarItem x:Name="StatusProgressItem"
                           HorizontalAlignment="Right"
                           KeyboardNavigation.IsTabStop="True"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressBar x:Name="StatusProgressBar"
                             Width="80" Height="14"
                             IsIndeterminate="True"
                             Focusable="True"
                             AutomationProperties.Name="{Binding StatusText, StringFormat='Syncing — {0}'}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- First-run keyboard tutorial overlay (topmost, covers everything when active) -->
        <local:TutorialOverlay x:Name="TutorialOverlayControl"
                               Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="4"
                               Panel.ZIndex="1000"/>
    </Grid>
    </Border>
</Window>
