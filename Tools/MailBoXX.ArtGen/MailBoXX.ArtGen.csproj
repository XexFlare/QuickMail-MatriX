<Project Sdk="Microsoft.NET.Sdk">

  <!-- MailBox MatriX: generates the original placeholder artwork shipped with the app (scenic
       background, contextual-image category art). Everything is drawn from code, so the output
       carries no third-party licence. Run: dotnet run -project Tools/MailBoXX.ArtGen -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
